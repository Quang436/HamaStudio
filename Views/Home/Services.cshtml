@model IEnumerable<HamaStudio.Models.DichVu>

@{
    ViewBag.Title = "Dịch vụ | Hama Studio Experience";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-dark: #1a1a1a;
        --accent-gold: #c5a880;
        --bg-soft: #fdfdfd;
        --text-muted: #6c757d;
        --soft-radius: 8px;
        --card-radius: 12px;
        --transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
        font-family: 'Montserrat', sans-serif;
        color: var(--primary-dark);
        background-color: var(--bg-soft);
    }

    .serif {
        font-family: 'Playfair Display', serif;
    }

    /* ===== HEADER ===== */
    .header-boxed {
        padding: 30px 0 20px;
        background: linear-gradient(to bottom, #f9f9f9, var(--bg-soft));
        margin-top: 0;
    }

    .section-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 4px;
        color: var(--accent-gold);
        font-weight: 700;
        display: block;
        margin-bottom: 15px;
    }

    /* ===== FEATURED SERVICE ===== */
    .featured-service-box {
        background: white;
        border-radius: var(--card-radius);
        overflow: hidden;
        box-shadow: 0 30px 60px rgba(0,0,0,0.05);
        border: 1px solid #f0f0f0;
    }

    .price-tag-big {
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--primary-dark);
        display: block;
        margin: 15px 0;
    }

    .service-list li {
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        font-size: 0.95rem;
        color: var(--text-muted);
    }

    .service-list i {
        color: var(--accent-gold);
        margin-right: 12px;
        font-size: 1.1rem;
    }

    /* ===== SERVICE CARDS ===== */
    .service-grid-card {
        background: white;
        border-radius: var(--card-radius);
        overflow: hidden;
        transition: var(--transition);
        border: 1px solid #eee;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .service-grid-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.05);
            border-color: var(--accent-gold);
        }

    .card-img-wrapper {
        position: relative;
        height: 240px;
        overflow: hidden;
    }

        .card-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: var(--transition);
        }

    .service-grid-card:hover .card-img-wrapper img {
        transform: scale(1.1);
    }

    /* Giá tiền hiển thị rõ ràng dưới mô tả */
    .card-price-display {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--primary-dark);
        margin-bottom: 20px;
        display: block;
    }

    .price-badge-small {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(4px);
        padding: 4px 12px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.75rem;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        color: var(--primary-dark);
    }

    /* ===== BUTTONS ===== */
    .btn-premium {
        background: var(--primary-dark);
        color: white;
        border-radius: var(--soft-radius);
        padding: 14px 30px;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        transition: var(--transition);
        border: 1px solid var(--primary-dark);
        text-decoration: none;
        display: inline-block;
    }

        .btn-premium:hover {
            background: transparent;
            color: var(--primary-dark);
        }

    .btn-outline-premium {
        background: transparent;
        color: var(--primary-dark);
        border: 1px solid #ddd;
        border-radius: var(--soft-radius);
        padding: 12px 20px;
        font-weight: 600;
        font-size: 0.8rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: var(--transition);
        text-decoration: none;
    }

        .btn-outline-premium:hover {
            border-color: var(--primary-dark);
            background: var(--primary-dark);
            color: white;
        }

    /* ===== SEARCH & FILTER ===== */
    .search-input-group input {
        border: 1px solid #e2e2e2 !important;
        transition: var(--transition);
    }
    .search-input-group input:focus {
        border-color: var(--accent-gold) !important;
        box-shadow: 0 10px 25px rgba(197, 168, 128, 0.1) !important;
        outline: none;
    }
    .pill-btn {
        background-color: white;
        border: 1px solid #e0e0e0;
        color: var(--primary-dark);
        padding: 8px 20px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
        transition: var(--transition);
        display: inline-block;
    }
    .pill-btn:hover {
        border-color: var(--accent-gold);
        color: var(--accent-gold);
        transform: translateY(-2px);
    }
    .pill-btn.active {
        background-color: var(--primary-dark);
        border-color: var(--primary-dark);
        color: white;
        box-shadow: 0 8px 15px rgba(0,0,0,0.1);
    }
</style>

<div class="header-boxed">
    <div class="container text-center">
        <span class="section-label">Investment</span>
        <h1 class="serif display-4 fw-bold mb-3">Dịch vụ của chúng tôi</h1>
        <p class="text-muted mx-auto mb-4" style="max-width: 550px; line-height: 1.8;">
            Chúng tôi tin rằng chất lượng nhiếp ảnh là một khoản đầu tư cho tương lai. Mỗi gói dịch vụ đều được thiết kế để tối ưu hóa trải nghiệm cá nhân của bạn.
        </p>

        <!-- SEARCH & FILTER SYSTEM -->
        <div class="search-filter-wrapper mx-auto mt-4" style="max-width: 800px;">
            <form action="/Home/Services" method="get" class="d-flex flex-column flex-md-row gap-3 justify-content-center align-items-center mb-3">
                
                <select name="categoryId" class="form-select rounded-pill py-2 px-4" style="max-width: 250px; font-size: 0.9rem; border-color: #e2e2e2; box-shadow: none; cursor: pointer;" onchange="this.form.submit()">
                    <option value="">Tất cả danh mục</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in (List<HamaStudio.Models.DanhMucDichVu>)ViewBag.Categories)
                        {
                            if (ViewBag.CurrentCategoryId != null && (int)ViewBag.CurrentCategoryId == cat.MaDanhMuc)
                            {
                                <option value="@cat.MaDanhMuc" selected>@cat.TenDanhMuc</option>
                            }
                            else
                            {
                                <option value="@cat.MaDanhMuc">@cat.TenDanhMuc</option>
                            }
                        }
                    }
                </select>

                <div class="search-input-group position-relative w-100 flex-grow-1">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" name="search" class="form-control ps-5 py-2 rounded-pill bg-white text-dark" placeholder="Tìm kiếm gói dịch vụ..." value="@ViewBag.CurrentSearch" style="letter-spacing: 0.5px; font-size: 0.9rem;" />
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                    {
                        <a href="/Home/Services?categoryId=@ViewBag.CurrentCategoryId" class="position-absolute top-50 end-0 translate-middle-y me-3 text-muted" title="Xóa tìm kiếm"><i class="bi bi-x-circle-fill"></i></a>
                    }
                </div>
                
                <button type="submit" class="btn btn-premium rounded-pill px-4 py-2 text-nowrap ls-1" style="font-size: 0.8rem; margin: 0; min-width: 120px;">Tìm kiếm</button>
            </form>
        </div>
    </div>
</div>

<div class="container py-5">
    @if (ViewBag.CurrentCategoryId == null)
    {
        <div class="featured-service-box mb-5 mx-auto" style="max-width: 900px;">
            <div class="row g-0 align-items-center">
                <div class="col-lg-6">
                    <img src="https://images.unsplash.com/photo-1545048702-79362596cdc9?w=900"
                         alt="Concept Giáng Sinh Premium" class="img-fluid w-100" style="height:380px; object-fit:cover;" />
                </div>
                <div class="col-lg-6 p-4 p-md-5">
                    <span class="hero-badge mb-2 d-inline-block px-3 py-1 bg-light small fw-bold text-uppercase ls-1">⭐ Best Seller</span>
                    <h3 class="serif h3 mb-2 fw-bold">Concept Giáng Sinh</h3>
                    <span class="price-tag-big fs-3 mb-3">5.000.000 ₫</span>
                    <p class="text-muted mb-3 small" style="line-height: 1.6;">
                        Mang hơi ấm mùa đông vào khung hình. Trải nghiệm không gian studio chuẩn Bắc Âu, kiến tạo những kỷ niệm ấm áp nhất.
                    </p>
                    <ul class="list-unstyled service-list mb-4 small">
                        <li><i class="bi bi-stars"></i> Concept trang trí độc quyền</li>
                        <li><i class="bi bi-clock"></i> 120 phút chụp hình chuyên nghiệp</li>
                        <li><i class="bi bi-person-check"></i> Stylist hỗ trợ tận nơi</li>
                    </ul>
                    <a href="/Booking" class="btn btn-premium w-100 py-2">ĐẶT LỊCH TRẢI NGHIỆM</a>
                </div>
            </div>
        </div>
    }

    <div class="@(ViewBag.CurrentCategoryId == null ? "mt-5 pt-4" : "mt-2")">
        <div class="d-flex align-items-end justify-content-between mb-5">
            <div>
                <span class="section-label">Premium Collections</span>
                <h2 class="serif h1">Gói chụp phổ biến</h2>
            </div>
            <div class="d-none d-md-block">
                <p class="text-muted small">Tư vấn kịch bản và Concept miễn phí cho mọi gói chụp.</p>
            </div>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="col-md-4">
                        <div class="service-grid-card">
                            <div class="card-img-wrapper">
                                <span class="price-badge-small">@((item.GiaTien / 1000000).ToString("0.#"))M</span>
                                <img src="@(string.IsNullOrEmpty(item.LinkAnhDaiDien) ? Url.Content("~/Content/Images/default.jpg") : (item.LinkAnhDaiDien.StartsWith("http") ? item.LinkAnhDaiDien : Url.Content("~/Content/Images/" + item.LinkAnhDaiDien)))" alt="@item.TenDichVu" onerror="this.src='https://images.unsplash.com/photo-1491002052546-bf38f186af56?w=600'" />
                            </div>
                            <div class="p-4 flex-grow-1 d-flex flex-column">
                                <h4 class="serif h5 mb-3">@item.TenDichVu</h4>
                                <p class="text-muted small mb-4 flex-grow-1">@item.MoTa</p>
                                <span class="card-price-display">@item.GiaTien.ToString("N0") ₫</span>
                                <a href="/Booking?serviceId=@item.MaDichVu" class="btn btn-outline-premium w-100 mb-2">ĐẶT LỊCH NGAY</a>
                                <a href="/Home/ServiceDetail/@item.MaDichVu" class="btn btn-link text-muted p-0 text-decoration-none" style="font-size:0.8rem; text-align:center;">XEM CHI TIẾT</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted">Hiện chưa có dịch vụ nào.</div>
            }
        </div>
    </div>

    <div class="mt-5 pt-5 text-center">
        <div class="p-5" style="border: 1px dashed var(--accent-gold); border-radius: var(--card-radius);">
            <h3 class="serif mb-3">Bạn cần một concept riêng biệt?</h3>
            <p class="text-muted mb-4 mx-auto" style="max-width: 600px;">
                Nếu các gói dịch vụ trên chưa phù hợp, đừng ngần ngại liên hệ để chúng tôi thiết kế một kịch bản chụp dành riêng cho ý tưởng của bạn.
            </p>
            <div class="d-flex gap-3 justify-content-center">
                <a href="/Home/About" class="btn btn-premium px-5">LIÊN HỆ TƯ VẤN</a>
            </div>
        </div>
    </div>
</div>