@{
    ViewBag.Title = "Hama Studio | Nghệ Thuật Nhiếp Ảnh Cao Cấp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-dark: #1a1a1a;
        --accent-color: #c5a880;
        --accent-gold: #c5a880;
        --bg-light: #fdfdfd;
        --text-muted: #666;
        --btn-radius: 8px;
        --card-radius: 12px;
        --transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
        font-family: 'Montserrat', sans-serif;
        color: var(--primary-dark);
        background-color: var(--bg-light);
    }

    .serif {
        font-family: 'Playfair Display', serif;
    }

    /* Button Styles */
    .btn-premium {
        background: var(--primary-dark);
        color: white;
        border-radius: var(--btn-radius);
        padding: 12px 30px;
        font-weight: 600;
        font-size: 0.85rem;
        letter-spacing: 1px;
        transition: var(--transition);
        border: 1px solid var(--primary-dark);
        text-transform: uppercase;
        text-decoration: none;
        display: inline-block;
    }

        .btn-premium:hover {
            background: var(--accent-color);
            border-color: var(--accent-color);
            color: white;
            transform: translateY(-2px);
        }

    .btn-outline-premium {
        background: transparent;
        color: var(--primary-dark);
        border-radius: var(--btn-radius);
        padding: 12px 30px;
        font-weight: 600;
        font-size: 0.85rem;
        letter-spacing: 1px;
        border: 1px solid #ddd;
        transition: var(--transition);
        text-transform: uppercase;
        text-decoration: none;
        display: inline-block;
    }

        .btn-outline-premium:hover {
            border-color: var(--primary-dark);
            background: #f9f9f9;
        }

    /* Section Components */
    .section-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 3px;
        color: var(--accent-color);
        font-weight: 700;
        margin-bottom: 10px;
        display: block;
    }

    .section-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.8rem;
        line-height: 1.2;
    }

    /* Hero Stats */
    .stat-box {
        border-left: 1px solid #eee;
        padding-left: 20px;
    }

    .stat-number {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0;
    }

    .stat-text {
        font-size: 0.75rem;
        color: var(--text-muted);
        text-transform: uppercase;
    }

    /* Portfolio */
    .portfolio-item {
        position: relative;
        overflow: hidden;
        border-radius: var(--card-radius);
        margin-bottom: 20px;
        aspect-ratio: 4/5;
    }

    .portfolio-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: 0.6s;
    }

    .portfolio-item:hover .portfolio-img {
        transform: scale(1.1);
    }

    .portfolio-info {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 20px;
        background: linear-gradient(transparent, rgba(0,0,0,0.8));
        color: white;
        opacity: 0;
        transition: 0.4s;
    }

    .portfolio-item:hover .portfolio-info {
        opacity: 1;
    }

    /* Process Step */
    .step-card {
        padding: 30px;
        background: white;
        border-radius: var(--card-radius);
        transition: 0.3s;
    }

    .step-number {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        color: #eee;
        line-height: 1;
    }

    /* Pricing */
    .price-card {
        border-radius: var(--card-radius);
        background: white;
        padding: 40px 30px;
        border: 1px solid #eee;
        transition: var(--transition);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .price-card-header {
        margin-bottom: 10px;
    }

    .price-card-body {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .price-card-footer {
        margin-top: auto;
    }

        .price-card:hover {
            border-color: var(--accent-color);
            box-shadow: 0 15px 30px rgba(0,0,0,0.05);
        }

    .price-features li {
        margin-bottom: 12px;
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    .price-features i {
        color: var(--accent-color);
        margin-right: 10px;
    }

    .cta-dark {
        background: var(--primary-dark);
        border-radius: var(--card-radius);
        padding: 60px;
        color: white;
    }
</style>

<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="hero-badge" style="color:var(--accent-color); font-weight:700; letter-spacing:3px; font-size:0.75rem">PREMIUM STUDIO</span>
                <h1 class="hero-title serif mb-4 mt-2" style="font-size: 4rem;">Lưu giữ <br /><span class="fst-italic" style="color: #c5a880;">linh hồn</span> khoảnh khắc</h1>
                <p class="text-muted mb-5" style="font-size:1.1rem; line-height:1.8; max-width:500px">
                    Hama Studio mang đến phong cách nhiếp ảnh Editorial đẳng cấp, giúp bạn tỏa sáng như trên bìa tạp chí thời trang.
                </p>
                <div class="d-flex gap-3 mb-5">
                    <a href="/Booking" class="btn btn-premium">ĐẶT LỊCH NGAY</a>
                    <a href="/Home/Portfolio" class="btn btn-outline-premium">KHÁM PHÁ</a>
                </div>
                <div class="row g-4 pt-4 border-top">
                    <div class="col-4">
                        <div class="stat-box">
                            <p class="stat-number">1000+</p>
                            <p class="stat-text">Khách hàng</p>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-box">
                            <p class="stat-number">550+</p>
                            <p class="stat-text">Bộ ảnh cưới</p>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-box">
                            <p class="stat-number">15+</p>
                            <p class="stat-text">Giải thưởng</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="position-relative">
                    <img src="https://images.unsplash.com/photo-1519741497674-611481863552?w=1000&q=85"
                         alt="Hama Studio" class="img-fluid hero-img shadow-lg" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5" style="background: #f8f8f8;">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="section-label">Làm việc chuyên nghiệp</span>
            <h2 class="section-title">Quy trình 4 bước tại Hama</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="step-card">
                    <div class="step-number">01</div>
                    <h5 class="fw-bold my-3">Tư vấn Concept</h5>
                    <p class="small text-muted">Lắng nghe ý tưởng và xây dựng kịch bản chụp riêng biệt cho bạn.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="step-card">
                    <div class="step-number">02</div>
                    <h5 class="fw-bold my-3">Chuẩn bị & Makeup</h5>
                    <p class="small text-muted">Đội ngũ Stylist giúp bạn chọn trang phục và makeup phù hợp nhất.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="step-card">
                    <div class="step-number">03</div>
                    <h5 class="fw-bold my-3">Buổi chụp hình</h5>
                    <p class="small text-muted">Nhiếp ảnh gia giàu kinh nghiệm dẫn dắt cảm xúc và góc mặt.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="step-card">
                    <div class="step-number">04</div>
                    <h5 class="fw-bold my-3">Hậu kỳ & Bàn giao</h5>
                    <p class="small text-muted">Xử lý màu sắc nghệ thuật và bàn giao bộ ảnh chất lượng cao.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="row mb-5 align-items-end">
            <div class="col-md-8">
                <span class="section-label">Selected Works</span>
                <h2 class="section-title">Những tuyệt tác tiêu biểu</h2>
            </div>
            <div class="col-md-4 text-md-end">
                <a href="/Home/Portfolio" class="text-dark text-decoration-none fw-bold" style="font-size: 0.85rem; letter-spacing:1px">XEM TẤT CẢ TÁC PHẨM →</a>
            </div>
        </div>

        <div class="row g-4">
            @{
                var portfolios = ViewBag.LatestPortfolios as IEnumerable<HamaStudio.Models.Portfolio>;
                if (portfolios != null && portfolios.Any())
                {
                    foreach (var item in portfolios.Take(3))
                    {
                        <div class="col-md-4">
                            <div class="portfolio-item">
                                <img src="@(item.LinkFileAnh.StartsWith("http") ? item.LinkFileAnh : Url.Content("~/Content/Images/" + item.LinkFileAnh))" onerror="this.src='https://images.unsplash.com/photo-1555507036-ab1f4038808a?w=600'" class="portfolio-img" alt="@item.TieuDe" />
                                <div class="portfolio-info">
                                    <h4 class="serif">@item.TieuDe</h4>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>
</section>

<section class="py-5" style="background: #fafafa;">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="section-label">Dịch vụ & Báo giá</span>
            <h2 class="section-title">Lựa chọn gói trải nghiệm</h2>
        </div>
        <div class="row g-4">
            @{
                var featuredServices = ViewBag.FeaturedServices as IEnumerable<HamaStudio.Models.DichVu>;
                if (featuredServices != null && featuredServices.Any())
                {
                    foreach (var svc in featuredServices)
                    {
                        <div class="col-lg-4">
                            <div class="price-card">
                                <div class="price-card-header">
                                    <h3 class="serif mb-3" style="font-size: 1.5rem; line-height: 1.4; min-height: 68px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@svc.TenDichVu</h3>
                                </div>
                                <div class="price-card-body">
                                    <div class="mb-3">
                                        <span class="fs-3 fw-bold text-dark">@svc.GiaTien.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) đ</span>
                                    </div>
                                    <ul class="list-unstyled price-features mb-4">
                                        <li class="small text-muted" style="line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;"><i class="bi bi-check2-circle"></i> @svc.MoTa</li>
                                    </ul>
                                </div>
                                <div class="price-card-footer">
                                    <a href="/Booking?serviceId=@svc.MaDichVu" class="btn btn-outline-premium w-100 mb-2">ĐẶT LỊCH NGAY</a>
                                    <a href="/Home/ServiceDetail/@svc.MaDichVu" class="btn btn-link text-muted w-100 p-0 text-decoration-none text-center" style="font-size:0.8rem;">Xem chi tiết</a>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>
</section>

<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-lg-4">
                <span class="section-label">Testimonials</span>
                <h2 class="section-title">Khách hàng <br />nói về Hama</h2>
                <p class="text-muted mt-3 small">Hơn 500+ đánh giá 5 sao trên Google & Facebook là động lực lớn nhất của chúng tôi.</p>
            </div>
            <div class="col-lg-8">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-4 border rounded-3" style="border-radius: var(--card-radius) !important;">
                            <div class="d-flex gap-1 mb-3 text-warning">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                            </div>
                            <p class="fst-italic text-muted small">"Bộ ảnh cưới của mình thật sự tuyệt vời. Cảm ơn Hama đã kiên nhẫn và giúp mình có được những khung hình tự nhiên nhất."</p>
                            <p class="fw-bold mb-0 mt-3 small">Minh Anh</p>
                            <span class="text-xs text-muted" style="font-size: 10px;">Bride - Wedding 2025</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-4 border rounded-3" style="border-radius: var(--card-radius) !important;">
                            <div class="d-flex gap-1 mb-3 text-warning">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                            </div>
                            <p class="fst-italic text-muted small">"Phong cách làm việc cực kỳ chuyên nghiệp. Hình ảnh sản phẩm rất sắc nét, giúp thương hiệu của mình nổi bật hơn hẳn."</p>
                            <p class="fw-bold mb-0 mt-3 small">Quốc Cường</p>
                            <span class="text-xs text-muted" style="font-size: 10px;">CEO - Fashion Brand</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 container">
    <div class="cta-dark text-center shadow-lg">
        <span class="section-label" style="color:#888">Bắt đầu ngay hôm nay</span>
        <h2 class="serif display-5 mb-4">Sẵn sàng cùng Hama viết nên <br />câu chuyện của bạn?</h2>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="/Booking" class="btn btn-light px-5 py-3 fw-bold" style="border-radius: var(--btn-radius); color: var(--primary-dark); text-decoration: none;">KHỞI ĐẦU NGAY</a>
            <a href="/Home/Contact" class="btn btn-outline-light px-5 py-3 fw-bold" style="border-radius: var(--btn-radius); text-decoration: none;">LIÊN HỆ TƯ VẤN</a>
        </div>
    </div>
</section>