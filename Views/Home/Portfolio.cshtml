@model IEnumerable<HamaStudio.Models.Portfolio>

@{
    ViewBag.Title = "Portfolio | Hama Studio Art";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-dark: #1a1a1a;
        --accent-gold: #c5a880;
        --bg-soft: #fdfdfd;
        --text-muted: #6c757d;
        --soft-radius: 8px;
        --card-radius: 12px;
        --transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
        font-family: 'Montserrat', sans-serif;
        color: var(--primary-dark);
        background-color: var(--bg-soft);
    }

    .serif {
        font-family: 'Playfair Display', serif;
    }

    /* Header Styling */
    .portfolio-header {
        padding: 30px 0 20px;
        text-align: center;
    }

    .section-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 4px;
        color: var(--accent-gold);
        font-weight: 700;
        display: block;
        margin-bottom: 15px;
    }

    /* Featured Work */
    .featured-work {
        position: relative;
        margin-bottom: 100px;
    }

    .featured-img-wrapper {
        overflow: hidden;
        border-radius: var(--card-radius);
        position: relative;
    }

    .featured-img {
        width: 100%;
        height: 550px;
        object-fit: cover;
        transition: var(--transition);
    }

    .featured-content {
        position: absolute;
        bottom: -40px;
        right: 40px;
        background: white;
        padding: 40px;
        max-width: 400px;
        border-radius: var(--card-radius);
        box-shadow: 0 20px 50px rgba(0,0,0,0.08);
        z-index: 10;
    }

    /* Storytelling Blocks */
    .dropcap {
        float: left;
        font-family: 'Playfair Display', serif;
        font-size: 4rem;
        line-height: 0.8;
        padding-right: 15px;
        color: var(--accent-gold);
    }

    .editorial-text {
        font-size: 1.05rem;
        line-height: 1.9;
        color: var(--text-muted);
        text-align: justify;
    }

    /* Gallery Grid */
    .gallery-item {
        position: relative;
        margin-bottom: 30px;
        border-radius: var(--card-radius);
        overflow: hidden;
        background: #eee;
    }

    .gallery-img {
        width: 100%;
        transition: var(--transition);
        display: block;
        object-fit: cover;
    }

    .gallery-item:hover .gallery-img {
        transform: scale(1.05);
    }

    .gallery-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(26, 26, 26, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: var(--transition);
    }

    .gallery-item:hover .gallery-overlay {
        opacity: 1;
    }

    /* Custom Buttons */
    .btn-premium {
        background: var(--primary-dark);
        color: white;
        border-radius: var(--soft-radius);
        padding: 16px 40px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        transition: var(--transition);
        display: inline-block;
        border: none;
    }

        .btn-premium:hover {
            background: var(--accent-gold);
            transform: translateY(-3px);
            color: white;
        }

    .styled-divider {
        width: 60px;
        height: 2px;
        background: var(--accent-gold);
        margin: 30px 0;
    }
</style>

<div class="container pb-5">
    <header class="portfolio-header">
        <span class="section-label">Gallery Archive</span>
        <h1 class="serif display-3 fw-bold mb-4">Portfolio</h1>
        <div class="d-flex justify-content-center">
            <p class="text-muted fst-italic py-2 px-4 border-start border-end" style="max-width: 650px; line-height: 1.8;">
                "Nơi cảm xúc được ghi lại qua ống kính chân thật nhất. Chúng tôi không chỉ chụp những gì bạn thấy, chúng tôi lưu giữ những gì bạn cảm nhận."
            </p>
        </div>
    </header>

    <section class="featured-work">
        <div class="featured-img-wrapper shadow-lg">
            <img src="https://images.unsplash.com/photo-1555507036-ab1f4038808a?w=1200&q=85"
                 alt="Featured" class="featured-img" />
        </div>
        <div class="featured-content d-none d-lg-block border-top border-5" style="border-color: var(--accent-gold) !important;">
            <span class="section-label" style="font-size: 0.65rem;">Concept của năm</span>
            <h3 class="serif mb-3">Editorial Fruit Art</h3>
            <p class="small text-muted mb-4">Sự kết hợp hoàn hảo giữa ánh sáng studio và nghệ thuật sắp đặt, kiến tạo nên chiều sâu không gian đầy mê hoặc.</p>
            <a href="#" class="text-dark fw-bold small text-decoration-none">CHI TIẾT DỰ ÁN <i class="bi bi-arrow-right ms-2"></i></a>
        </div>
    </section>

    <section class="row py-5 align-items-center">
        <div class="col-lg-5 pe-lg-5">
            <h2 class="serif mb-4">Định nghĩa lại <br /><span class="fst-italic" style="color:var(--accent-gold)">thẩm mỹ</span> cá nhân</h2>
            <div class="styled-divider"></div>
            <p class="editorial-text">
                <span class="dropcap">T</span>ại Hama Studio, chúng tôi tin rằng mỗi khoảnh khắc đều xứng đáng được tôn vinh như một tác phẩm nghệ thuật. Dịch vụ của chúng tôi không chỉ dừng lại ở việc bấm máy, mà là cả một quy trình sáng tạo đầy cảm hứng.
            </p>
            <p class="editorial-text">
                Từ việc lên ý tưởng độc bản, thiết lập ánh sáng chuẩn mực cho đến kỹ thuật hậu kỳ tinh tế, đội ngũ Hama luôn cam kết mang lại chất lượng vượt xa mọi kỳ vọng.
            </p>
        </div>
        <div class="col-lg-7 mt-5 mt-lg-0">
            <div class="row g-3">
                <div class="col-6">
                    <img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=700&q=85"
                         class="img-fluid shadow-sm" style="border-radius: var(--card-radius); aspect-ratio: 1/1; object-fit: cover;" alt="Art 1" />
                </div>
                <div class="col-6 mt-5">
                    <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=700&q=85"
                         class="img-fluid shadow-sm" style="border-radius: var(--card-radius); aspect-ratio: 1/1; object-fit: cover;" alt="Art 2" />
                </div>
            </div>
        </div>
    </section>

    <section class="py-5">
        <div class="row mb-5">
            <div class="col-lg-6">
                <span class="section-label">Bộ sưu tập</span>
                <h2 class="serif display-6">Sắc màu sau ống kính</h2>
            </div>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="col-md-4">
                        <div class="gallery-item" style="height: 400px;">
                            <img src="@(item.LinkFileAnh.StartsWith("http") ? item.LinkFileAnh : Url.Content("~/Content/Images/" + item.LinkFileAnh))" onerror="this.src='https://images.unsplash.com/photo-1519225421980-715cb0215aed?w=1000'" class="gallery-img h-100" alt="@item.TieuDe" />
                            <div class="gallery-overlay">
                                <div class="text-center text-white p-4">
                                    <span class="text-uppercase small ls-2">@(item.DichVu?.TenDichVu)</span>
                                    <h3 class="serif">@item.TieuDe</h3>
                                    <div class="styled-divider mx-auto my-3" style="background: white; width: 30px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted">Hiện chưa có dự án nào trong Portfolio.</div>
            }
        </div>
    </section>

    <div class="py-5 text-center mt-5">
        <div class="p-5 bg-dark text-white shadow-lg" style="border-radius: var(--card-radius); background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%) !important;">
            <h2 class="serif display-6 mb-4">Khởi đầu câu chuyện của bạn</h2>
            <p class="opacity-75 mb-5 mx-auto" style="max-width: 550px;">Hãy để Hama Studio cùng bạn lưu giữ những khoảnh khắc quý giá nhất bằng sự tận tâm và chuyên nghiệp hàng đầu.</p>
            <a href="/Booking" class="btn btn-premium">
                ĐẶT LỊCH CHỤP NGAY <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</div>