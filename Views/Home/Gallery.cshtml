@model IEnumerable<HamaStudio.Models.Portfolio>

@{
    ViewBag.Title = "Gallery | Hama Studio Art";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-dark: #1a1a1a;
        --accent-gold: #c5a880;
        --bg-soft: #fdfdfd;
        --text-muted: #6c757d;
        --card-radius: 12px;
        --transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
        font-family: 'Montserrat', sans-serif;
        background-color: var(--bg-soft);
        color: var(--primary-dark);
    }

    .serif {
        font-family: 'Playfair Display', serif;
    }

    /* ===== HERO SECTION ===== */
    .gallery-hero {
        position: relative;
        height: 50vh;
        min-height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
        overflow: hidden;
    }

        .gallery-hero img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
            filter: brightness(0.5) grayscale(20%);
        }

    .gallery-hero-content {
        position: relative;
        z-index: 2;
    }

    /* ===== FILTER BAR ===== */
    .filter-container {
        padding: 50px 0;
    }

    .filter-pill {
        background: transparent;
        border: 1px solid #eee;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        padding: 12px 30px;
        transition: var(--transition);
        border-radius: 50px;
        cursor: pointer;
        margin: 5px;
    }

        .filter-pill.active {
            background-color: var(--primary-dark) !important;
            border-color: var(--primary-dark);
            color: #fff !important;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

    /* ===== GALLERY GRID (PRO MASONRY) ===== */
    .gallery-grid {
        opacity: 1;
        transition: opacity 0.4s ease;
    }

    .gallery-item {
        margin-bottom: 24px;
    }

    .gallery-card {
        position: relative;
        overflow: hidden;
        border-radius: var(--card-radius);
        background: #f8f8f8;
        cursor: crosshair;
        height: 100%;
    }

    .gallery-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 1.2s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    /* Hover Effects */
    .gallery-card:hover .gallery-img {
        transform: scale(1.1);
    }

    .gallery-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: var(--transition);
        color: white;
    }

    .gallery-card:hover .gallery-overlay {
        opacity: 1;
    }

    .gallery-tag {
        position: absolute;
        top: 20px;
        left: 20px;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--accent-gold);
        opacity: 0;
        transition: var(--transition);
        transform: translateY(-10px);
    }

    .gallery-card:hover .gallery-tag {
        opacity: 1;
        transform: translateY(0);
    }

    /* Phân loại kích thước để Grid trông chuyên nghiệp */
    .h-300 {
        height: 300px;
    }

    .h-400 {
        height: 400px;
    }

    .h-600 {
        height: 600px;
    }

    /* CTA Section */
    .btn-premium {
        background: var(--primary-dark);
        color: white;
        border-radius: 8px;
        padding: 16px 45px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        transition: var(--transition);
        display: inline-block;
        border: none;
    }

        .btn-premium:hover {
            background: var(--accent-gold);
            color: white;
            transform: translateY(-3px);
        }
</style>

<div class="gallery-hero">
    <img src="https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=1400&q=80" alt="Studio Gallery" />
    <div class="gallery-hero-content">
        <span style="color:var(--accent-gold); letter-spacing: 6px; text-transform: uppercase; font-size: 0.75rem; font-weight: 700;">Hama Visual Library</span>
        <h1 class="serif display-2 fw-bold mb-3 mt-2 text-white">Gallery</h1>
        <p class="text-white-50 serif fst-italic fs-5">"Nghệ thuật là sự đóng băng của cảm xúc"</p>
    </div>
</div>

<div class="filter-container">
    <div class="container">
        <div class="d-flex gap-2 flex-wrap justify-content-center">
            <button class="filter-pill active" data-filter="all">Tất cả</button>
            <button class="filter-pill" data-filter="wedding">Ảnh cưới</button>
            <button class="filter-pill" data-filter="portrait">Chân dung</button>
            <button class="filter-pill" data-filter="nature">Thiên nhiên</button>
            <button class="filter-pill" data-filter="family">Gia đình</button>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-4 gallery-grid" id="galleryGrid">

        @if (Model != null && Model.Any())
        {
            int i = 0;
            foreach (var item in Model)
            {
                // Alternate sizes for masonry effect
                string hClass = "h-400";
                if (i % 5 == 0)
                {
                    hClass = "h-600";
                }
                else if (i % 3 == 0)
                {
                    hClass = "h-300";
                }

                <div class="col-lg-4 col-md-6 gallery-item" data-cat="all">
                    <div class="gallery-card @hClass">
                        <span class="gallery-tag">@item.TieuDe</span>
                        <img src="@(item.LinkFileAnh.StartsWith("http") ? item.LinkFileAnh : Url.Content("~/Content/Images/" + item.LinkFileAnh))" onerror="this.src='https://images.unsplash.com/photo-1519741497674-611481863552?w=800&q=80'" class="gallery-img" />
                        <div class="gallery-overlay"><i class="bi bi-fullscreen fs-4"></i></div>
                    </div>
                </div>
                i++;
            }
        }
        else
        {
            <div class="col-12 text-center text-muted">Chưa có ảnh trong gallery.</div>
        }
    </div>

    <div class="text-center mt-5 pt-4">
        <div style="width: 50px; height: 1px; background: #ddd; margin: 0 auto 30px;"></div>
        <p class="text-muted small mb-4 text-uppercase ls-2">Khám phá nhiều hơn từ Hama</p>
        <a href="/Home/Portfolio" class="btn btn-premium shadow-lg">XEM PORTFOLIO ĐẦY ĐỦ</a>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.filter-pill').forEach(function (btn) {
            btn.addEventListener('click', function () {
                // Active state
                document.querySelectorAll('.filter-pill').forEach(function (b) { b.classList.remove('active'); });
                this.classList.add('active');

                const filter = this.dataset.filter;
                const grid = document.getElementById('galleryGrid');
                const items = document.querySelectorAll('.gallery-item');

                // Hiệu ứng mờ dần khi chuyển đổi
                grid.style.opacity = '0';

                setTimeout(() => {
                    items.forEach(function (item) {
                        if (filter === 'all' || item.dataset.cat === filter) {
                            item.style.display = 'block';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                    grid.style.opacity = '1';
                }, 400);
            });
        });
    </script>
}