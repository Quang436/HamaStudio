@{
    ViewBag.Title = "About & Contact | Hama Studio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-dark: #1a1a1a;
        --accent-gold: #c5a880;
        --bg-soft: #fdfdfd;
        --text-muted: #6c757d;
        --card-radius: 12px;
        --transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
        font-family: 'Montserrat', sans-serif;
        background-color: var(--bg-soft);
        color: var(--primary-dark);
    }

    .serif {
        font-family: 'Playfair Display', serif;
    }

    /* Header */
    .section-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 4px;
        color: var(--accent-gold);
        font-weight: 700;
        display: block;
        margin-bottom: 10px;
    }

    /* About Section */
    .about-img-wrapper {
        position: relative;
        border-radius: var(--card-radius);
        overflow: hidden;
    }

    .about-img {
        width: 100%;
        height: 500px;
        object-fit: cover;
    }

    .stats-item {
        border-left: 1px solid #eee;
        padding-left: 20px;
        margin-bottom: 20px;
    }

    .stats-number {
        font-size: 2rem;
        font-weight: 700;
        color: var(--primary-dark);
        margin-bottom: 0;
    }

    /* Contact Form */
    .contact-box {
        background: white;
        border-radius: var(--card-radius);
        padding: 50px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.03);
        border: 1px solid #f0f0f0;
    }

    .form-label-luxury {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--text-muted);
        margin-bottom: 8px;
    }

    .input-luxury {
        border: none;
        border-bottom: 1px solid #eee;
        border-radius: 0;
        padding: 12px 0;
        font-size: 0.95rem;
        background: transparent;
        width: 100%;
        outline: none;
        transition: var(--transition);
    }

        .input-luxury:focus {
            border-color: var(--accent-gold);
        }

    .contact-info-item {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 25px;
    }

        .contact-info-item i {
            color: var(--accent-gold);
            font-size: 1.2rem;
        }

    .btn-premium {
        background: var(--primary-dark);
        color: white;
        border: none;
        padding: 16px 40px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        border-radius: 4px;
        transition: var(--transition);
        width: 100%;
    }

        .btn-premium:hover {
            background: var(--accent-gold);
            transform: translateY(-3px);
        }
</style>

<div class="container py-5">

    <section class="row align-items-center g-5 mb-5 pb-5">
        <div class="col-lg-6 order-2 order-lg-1">
            <span class="section-label">Hành trình 5 năm</span>
            <h1 class="serif display-4 fw-bold mb-4">Hama Studio — <br />Nghệ thuật kể chuyện <br /><span class="fst-italic" style="color:var(--accent-gold)">qua lăng kính</span></h1>
            <p class="text-muted lh-lg mb-4">
                Được thành lập từ năm 2019 tại Đà Nẵng, Hama Studio không chỉ đơn thuần là một đơn vị chụp ảnh. Chúng tôi là những người kể chuyện bằng ánh sáng, chuyên kiến tạo những khoảnh khắc mang tính di sản.
            </p>
            <p class="text-muted lh-lg mb-5">
                Mỗi concept tại Hama đều được đầu tư tỉ mỉ từ khâu lên ý tưởng nghệ thuật, dàn dựng bối cảnh cho đến quy trình xử lý hậu kỳ tiêu chuẩn quốc tế. Chúng tôi tin rằng, mỗi cá nhân đều có một bản sắc độc nhất cần được tôn vinh.
            </p>

            <div class="row">
                <div class="col-4">
                    <div class="stats-item">
                        <p class="stats-number">1000+</p>
                        <p class="small text-muted text-uppercase ls-1">Dự án</p>
                    </div>
                </div>
                <div class="col-4">
                    <div class="stats-item">
                        <p class="stats-number">05</p>
                        <p class="small text-muted text-uppercase ls-1">Năm</p>
                    </div>
                </div>
                <div class="col-4">
                    <div class="stats-item">
                        <p class="stats-number">98%</p>
                        <p class="small text-muted text-uppercase ls-1">Hài lòng</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 order-1 order-lg-2">
            <div class="about-img-wrapper shadow-lg">
                <img src="https://images.unsplash.com/photo-1452587925148-ce544e77e70d?w=800&q=85" class="about-img" alt="Hama Studio Team" />
            </div>
        </div>
    </section>

    <div style="height: 1px; background: linear-gradient(to right, transparent, #eee, transparent); margin-bottom: 80px;"></div>

    <section class="row g-5">
        <div class="col-lg-5">
            <span class="section-label">Connect with us</span>
            <h2 class="serif display-5 fw-bold mb-4">Liên hệ</h2>
            <p class="text-muted mb-5">Bạn có một ý tưởng độc đáo hay muốn nhận báo giá chi tiết? Hãy để lại lời nhắn, đội ngũ của Hama sẽ phản hồi bạn trong vòng 24h.</p>

            <div class="contact-info-item">
                <i class="bi bi-geo-alt"></i>
                <div>
                    <h6 class="fw-bold mb-1">Địa chỉ Studio</h6>
                    <p class="small text-muted m-0">123 Võ Nguyên Giáp, Quận Ngũ Hành Sơn, Đà Nẵng</p>
                </div>
            </div>

            <div class="contact-info-item">
                <i class="bi bi-telephone"></i>
                <div>
                    <h6 class="fw-bold mb-1">Điện thoại</h6>
                    <p class="small text-muted m-0">+84 336 486 377</p>
                </div>
            </div>

            <div class="contact-info-item">
                <i class="bi bi-envelope"></i>
                <div>
                    <h6 class="fw-bold mb-1">Email liên hệ</h6>
                    <p class="small text-muted m-0">hello@hamastudio.vn</p>
                </div>
            </div>

            <div class="mt-5 pt-3 border-top w-75">
                <p class="small fw-bold text-uppercase ls-1 mb-3">Follow our Art</p>
                <div class="d-flex gap-3">
                    <a href="#" class="text-dark fs-5"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="text-dark fs-5"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-dark fs-5"><i class="bi bi-tiktok"></i></a>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="contact-box">
                <form action="/Home/Contact" method="post">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label-luxury">Họ và tên của bạn</label>
                            <input type="text" name="FullName" class="input-luxury" placeholder="VD: Nguyễn Văn A" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-luxury">Địa chỉ Email</label>
                            <input type="email" name="Email" class="input-luxury" placeholder="VD: email@example.com" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label-luxury">Số điện thoại</label>
                            <input type="tel" name="Phone" class="input-luxury" placeholder="VD: 0905 123 456" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label-luxury">Lựa chọn dịch vụ</label>
                            <select class="input-luxury" name="ServiceInterest">
                                <option value="">-- Chọn dịch vụ bạn quan tâm --</option>
                                <option value="Wedding">Phóng sự cưới</option>
                                <option value="Family">Ảnh gia đình</option>
                                <option value="Product">Ảnh sản phẩm</option>
                                <option value="Other">Yêu cầu khác</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label-luxury">Lời nhắn của bạn</label>
                            <textarea name="Message" class="input-luxury" rows="3" placeholder="Gửi yêu cầu hoặc ý tưởng của bạn cho Hama..."></textarea>
                        </div>
                        <div class="col-md-12 mt-5">
                            <button type="submit" class="btn-premium">GỬI YÊU CẦU LIÊN HỆ</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>

</div>

<div class="container-fluid p-0 mt-5 pt-5">
    <div class="map-wrapper" style="position: relative; height: 450px; width: 100%; overflow: hidden;">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3834.10444365634!2d108.2415147758253!3d16.059434439712015!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3142177f196d6313%3A0x1ec7952ca7289567!2zMTIzIFbDตIE5ndXnDqm4gR2nDoXAsIFBoxrDhu5tjIE3hu7ksIFPGoW4gVHLDoCwgxJDDoCBO4bq1bmcsIFZp4buHdCBOYW0!5e0!3m2!1svi!2s!4v1712760000000!5m2!1svi!2s"
                width="100%"
                height="450"
                style="border:0; filter: grayscale(100%) contrast(1.2) opacity(0.8); transition: all 0.8s ease;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                onmouseover="this.style.filter='grayscale(0%) contrast(1) opacity(1)'"
                onmouseout="this.style.filter='grayscale(100%) contrast(1.2) opacity(0.8)'">
        </iframe>

        <div class="position-absolute d-none d-md-block" style="bottom: 30px; left: 30px; z-index: 10;">
            <div class="bg-white p-3 shadow-sm" style="border-radius: 4px; border-left: 4px solid var(--accent-gold);">
                <p class="m-0 small fw-bold text-uppercase ls-1">Hama Studio HQ</p>
                <p class="m-0 text-muted" style="font-size: 11px;">Da Nang, Viet Nam</p>
            </div>
        </div>
    </div>
</div>