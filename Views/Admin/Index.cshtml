            e = document.getElementById('bs-gia'); if (e) e.value = '';
            loadDichVuDropdown('bs-dv', '');
            e = document.getElementById('modal-bs-title'); if (e) e.textContent = 'Th\u00EAm d\u1ECBch v\u1EE5 b\u1ED5 sung';
            showModal('modal-bs');
        }
        function editBS(id, ten, mota, gia, dv) {
            var e;
            e = document.getElementById('bs-mode'); if (e) e.value = 'edit';
            e = document.getElementById('bs-id'); if (e) e.value = id;
            e = document.getElementById('bs-ten'); if (e) e.value = ten;
            e = document.getElementById('bs-mota'); if (e) e.value = mota;
            e = document.getElementById('bs-gia'); if (e) e.value = gia;
            loadDichVuDropdown('bs-dv', dv);
            e = document.getElementById('modal-bs-title'); if (e) e.textContent = 'S\u1EEDa d\u1ECBch v\u1EE5 b\u1ED5 sung';
            showModal('modal-bs');
        }
        function submitBS() {
            var tenEl = document.getElementById('bs-ten');
            var ten = tenEl ? tenEl.value.trim() : '';
            if (!ten) { alert('Vui l\u00F2ng nh\u1EADp t\u00EAn!'); return }
            var modeEl = document.getElementById('bs-mode');
            var mode = modeEl ? modeEl.value : 'add';
            var fd = new FormData();
            fd.append('tenDVBS', ten);
            var m = document.getElementById('bs-mota'); fd.append('moTa', m ? m.value : '');
            var g = document.getElementById('bs-gia'); fd.append('giaTien', g ? g.value : '0');
            var dv = document.getElementById('bs-dv'); fd.append('maDichVu', dv ? dv.value : '0');
            if (mode === 'edit') { var i = document.getElementById('bs-id'); fd.append('maDVBS', i ? i.value : '') }
            var url = mode === 'add' ? '/Admin/ThemDichVuBoSung' : '/Admin/SuaDichVuBoSung';
            fetch(url, { method: 'POST', body: fd }).then(function (r) { return r.json() }).then(function (res) {
                if (res.success) { hideModal('modal-bs'); loadDichVuBoSung() } else { alert('L\u1ED7i!') }
            }).catch(function () { alert('L\u1ED7i k\u1EBFt n\u1ED1i!') });
        }
        function deleteBS(id) {
            if (!confirm('X\u00F3a d\u1ECBch v\u1EE5 b\u1ED5 sung n\u00E0y?')) return;
            var fd = new FormData(); fd.append('maDVBS', id);
            fetch('/Admin/XoaDichVuBoSung', { method: 'POST', body: fd }).then(function () { loadDichVuBoSung() });
        }

        // === MODAL ===
        function showModal(id) {
            var el = document.getElementById(id);
            if (el) { el.style.display = 'flex'; el.classList.add('show') }
        }
        function hideModal(id) {
            var el = document.getElementById(id);
            if (el) { el.style.display = 'none'; el.classList.remove('show') }
        }
        document.addEventListener('click', function (e) {
            if (e.target && e.target.classList && e.target.classList.contains('modal-overlay')) {
                e.target.style.display = 'none'; e.target.classList.remove('show');
            }
        });
        // === PORTFOLIO PREVIEW & DRAG DROP ===
        function previewPFImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var preview = document.getElementById('pf-preview');
                    var placeholder = document.getElementById('pf-placeholder');
                    var previewImg = document.getElementById('pf-preview-img');
                    if (preview && placeholder && previewImg) {
                        preview.style.display = 'block';
                        placeholder.style.display = 'none';
                        previewImg.src = e.target.result;
                    }
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Initialize Drag & Drop
        document.addEventListener('DOMContentLoaded', function () {
            var zone = document.getElementById('pf-upload-zone');
            if (zone) {
                ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                    zone.addEventListener(eventName, preventDefaults, false);
                });
                function preventDefaults(e) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                ['dragenter', 'dragover'].forEach(eventName => {
                    zone.addEventListener(eventName, () => zone.classList.add('dragover'), false);
                });
                ['dragleave', 'drop'].forEach(eventName => {
                    zone.addEventListener(eventName, () => zone.classList.remove('dragover'), false);
                });
                zone.addEventListener('drop', handleDrop, false);
                function handleDrop(e) {
                    var dt = e.dataTransfer;
                    var files = dt.files;
                    var input = document.getElementById('pf-file');
                    if (input) {
                        input.files = files;
                        previewPFImage(input);
                    }
                }
            }
        });
    </script>
    <script src="~/Scripts/schedule-admin.js"></script>
</body>

</html>
