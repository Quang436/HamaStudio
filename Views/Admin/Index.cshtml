@{
    Layout = null;
}
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Admin — Hama Studio</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/Content/admin.css" />
</head>

<body class="admin-body">
    <!-- SIDEBAR -->
    <aside class="admin-sidebar">
        <div class="sidebar-logo">HAMA STUDIO<span>Admin Panel</span></div>
        <nav class="sidebar-nav">
            <div class="nav-item active" data-sec="dashboard" onclick="switchSection('dashboard')"><i
                    class="bi bi-grid"></i><span>Tổng quan</span></div>
            <div class="nav-item" data-sec="schedule" onclick="switchSection('schedule')"><i
                    class="bi bi-calendar2-check"></i><span>Lên lịch chụp</span></div>
            <div class="nav-item" data-sec="booking-confirmed" onclick="switchSection('booking-confirmed')"><i
                    class="bi bi-calendar-check"></i><span>Lịch đã xác nhận</span></div>
            <div class="nav-item" data-sec="history" onclick="switchSection('history')"><i
                    class="bi bi-check2-circle"></i><span>Lịch sử hoàn thành</span></div>
            <div class="nav-item" data-sec="customers" onclick="switchSection('customers')"><i
                    class="bi bi-people"></i><span>Khách hàng</span></div>
            <div class="nav-item" data-sec="services" onclick="switchSection('services')"><i
                    class="bi bi-camera"></i><span>Dịch vụ</span></div>
            <div class="nav-item" data-sec="portfolio" onclick="switchSection('portfolio')"><i
                    class="bi bi-images"></i><span>Portfolio</span></div>
            <div class="nav-item" data-sec="addons" onclick="switchSection('addons')"><i
                    class="bi bi-plus-circle"></i><span>Dịch vụ bổ sung</span></div>
        </nav>
        <div class="sidebar-footer">&copy; 2026 Hama Studio</div>
    </aside>

    <!-- MAIN -->
    <main class="admin-main">
        <header class="admin-header">
            <h2 id="page-title">Tổng quan</h2>
            <div class="header-actions">
                <span style="font-size:12px;color:var(--text2);margin-right:8px">Xin chào, <b
                        style="color:var(--text)">@(Session["FullName"] ?? "Admin")</b></span>
                <a href="/Account/Logout" class="btn btn-sm"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a>
            </div>
        </header>
        <div class="admin-content">

            <!-- ═══ DASHBOARD ═══ -->
            <div class="section active" id="sec-dashboard">
                <div class="stats-grid" id="dashboard-stats">
                    <div class="stat-card">
                        <div class="label">Tổng khách hàng</div>
                        <div class="value">@ViewBag.TongKhachHang</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Tổng lịch đặt</div>
                        <div class="value">@ViewBag.TongDatLich</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Tổng doanh thu</div>
                        <div class="value">@(String.Format("{0:N0}đ", ViewBag.TongDoanhThu))</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Chờ xác nhận</div>
                        <div class="value" style="color:var(--yellow)">@ViewBag.LichChoXacNhan</div>
                    </div>
                </div>

                <!-- Bo loc thong ke -->
                <div class="filter-bar" style="flex-wrap:wrap;gap:10px;align-items:flex-end">
                    <div>
                        <label
                            style="font-size:10px;color:var(--text2);display:block;margin-bottom:4px;text-transform:uppercase;letter-spacing:1px">Năm</label>
                        <select id="revenue-year" class="search-input" style="width:100px">
                            @for (int y = 2023; y <= 2027; y++)
                            {
                                <option value="@y" @(y == DateTime.Now.Year ? "selected" : "")>@y</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label
                            style="font-size:10px;color:var(--text2);display:block;margin-bottom:4px;text-transform:uppercase;letter-spacing:1px">Xem
                            theo ngày</label>
                        <input type="date" id="revenue-day-from" class="search-input" style="width:155px" />
                    </div>
                    <div>
                        <label
                            style="font-size:10px;color:var(--text2);display:block;margin-bottom:4px;text-transform:uppercase;letter-spacing:1px">Đến
                            ngày</label>
                        <input type="date" id="revenue-day-to" class="search-input" style="width:155px" />
                    </div>
                    <button class="btn btn-primary btn-sm" style="height:34px" onclick="loadThongKe()"><i
                            class="bi bi-search"></i> Xem thống kê</button>
                    <button class="btn btn-sm" style="height:34px" onclick="exportReport()"><i
                            class="bi bi-download"></i> Xuất báo cáo</button>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px">
                    <div class="chart-container">
                        <h4>Biểu đồ doanh thu</h4>
                        <div class="chart-bar-wrap" id="revenue-chart"></div>
                    </div>
                    <div>
                        <div class="stats-grid" style="grid-template-columns:1fr 1fr;margin-bottom:16px">
                            <div class="stat-card">
                                <div class="label">Doanh thu</div>
                                <div class="value" id="rv-total">--</div>
                            </div>
                            <div class="stat-card">
                                <div class="label">Lịch đặt</div>
                                <div class="value" id="rv-booking">--</div>
                            </div>
                            <div class="stat-card">
                                <div class="label">Đã hủy</div>
                                <div class="value" id="rv-cancel" style="color:var(--red)">--</div>
                            </div>
                            <div class="stat-card">
                                <div class="label">Đánh giá TB</div>
                                <div class="value" id="rv-star" style="color:var(--yellow)">--</div>
                            </div>
                        </div>
                        <div class="table-wrap">
                            <table class="data-table" style="min-width:auto">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Dịch vụ</th>
                                        <th>Doanh thu</th>
                                    </tr>
                                </thead>
                                <tbody id="tbl-revenue-dv"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ═══ PENDING ═══ -->
            <div class="section" id="sec-booking-pending">
                <div class="table-header">
                    <h3>Lịch chờ xác nhận</h3>
                    <div class="filter-bar" style="margin-bottom:0">
                        <input class="search-input" id="search-pending" placeholder="Tìm khách hàng, dịch vụ..." />
                        <button class="btn btn-sm" onclick="doSearch('tbl-pending','search-pending')"><i
                                class="bi bi-search"></i> Tìm</button>
                    </div>
                </div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Khách hàng</th>
                                <th>SĐT</th>
                                <th>Dịch vụ</th>
                                <th>Ngày chụp</th>
                                <th>Khung giờ</th>
                                <th>Địa điểm</th>
                                <th>Tổng tiền</th>
                                <th>Đã cọc</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="tbl-pending"></tbody>
                    </table>
                </div>
            </div>

            <!-- ═══ SCHEDULE ═══ -->
            <div class="section" id="sec-schedule">
                <div class="table-header">
                    <h3>Lên lịch chụp</h3>
                    <div class="filter-bar" style="margin-bottom:0">
                        <select id="filter-schedule-service" class="search-input" style="width:200px"
                            onchange="loadSchedule()">
                            <option value="">Tất cả dịch vụ</option>
                        </select>
                        <input type="month" id="filter-schedule-month" class="search-input" style="width:150px"
                            onchange="loadSchedule()" />
                        <button class="btn btn-primary btn-sm" onclick="showAddSchedule()"><i class="bi bi-plus"></i>
                            Lên lịch mới</button>
                        <button class="btn btn-sm" style="background:#6f42c1;color:#fff" onclick="sendRemindersManual()"
                            title="Gửi nhắc lịch cho khách chụp ngày mai"><i class="bi bi-bell"></i> Nhắc lịch
                            ngay</button>
                    </div>
                </div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Dịch vụ</th>
                                <th>Ngày chụp</th>
                                <th>Tổng lịch</th>
                                <th>Lịch còn lại</th>
                                <th>Số khung giờ</th>
                                <th>Trạng thái</th>
                                <th>Ghi chú</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="tbl-schedule"></tbody>
                    </table>
                </div>
            </div>

            <!-- ═══ CONFIRMED ═══ -->
            <div class="section" id="sec-booking-confirmed">
                <div class="table-header">
                    <h3>Lịch đã xác nhận / đặt cọc</h3>
                    <div class="filter-bar" style="margin-bottom:0">
                        <input class="search-input" id="search-confirmed" placeholder="Tìm khách hàng, dịch vụ..." />
                        <button class="btn btn-sm" onclick="doSearch('tbl-confirmed','search-confirmed')"><i
                                class="bi bi-search"></i> Tìm</button>
                    </div>
                </div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Khách hàng</th>
                                <th>SĐT</th>
                                <th>Dịch vụ</th>
                                <th>Ngày chụp</th>
                                <th>Khung giờ</th>
                                <th>Địa điểm</th>
                                <th>Tổng tiền</th>
                                <th>Đã cọc</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="tbl-confirmed"></tbody>
                    </table>
                </div>
            </div>

            <!-- ═══ HISTORY ═══ -->
            <div class="section" id="sec-history">
                <div class="table-header">
                    <h3>Lịch sử hoàn thành</h3>
                    <div class="filter-bar" style="margin-bottom:0">
                        <input class="search-input" id="search-history" placeholder="Tìm khách hàng, dịch vụ..." />
                        <button class="btn btn-sm" onclick="doSearch('tbl-history','search-history')"><i
                                class="bi bi-search"></i> Tìm</button>
                    </div>
                </div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Khách hàng</th>
                                <th>SĐT</th>
                                <th>Dịch vụ</th>
                                <th>Ngày chụp</th>
                                <th>Khung giờ</th>
                                <th>Địa điểm</th>
                                <th>Tổng tiền</th>
                                <th>Đã cọc</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="tbl-history"></tbody>
                    </table>
                </div>
            </div>

            <!-- ═══ CUSTOMERS ═══ -->
            <div class="section" id="sec-customers">
                <div class="table-header">
                    <h3>Khách hàng</h3>
                    <div class="filter-bar" style="margin-bottom:0">
                        <select id="filter-kh-status" class="search-input" style="width:140px">
                            <option value="">Tất cả</option>
                            <option value="Hoạt động">Hoạt động</option>
                            <option value="Khóa">Đã khóa</option>
                        </select>
                        <input class="search-input" id="search-customers" placeholder="Tìm tên, email, SĐT..." />
                        <button class="btn btn-sm" onclick="filterKhachHang()"><i class="bi bi-search"></i> Tìm</button>
                    </div>
                </div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Họ tên</th>
                                <th>Email</th>
                                <th>SĐT</th>
                                <th>Địa chỉ</th>
                                <th>Số lịch</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="tbl-customers"></tbody>
                    </table>
                </div>
            </div>

            <!-- ═══ SERVICES ═══ -->
            <div class="section" id="sec-services">
                <div class="table-header">
                    <h3>Dịch vụ</h3>
                    <div class="filter-bar" style="margin-bottom:0">
                        <input class="search-input" id="search-services" placeholder="Tìm tên dịch vụ..." />
                        <button class="btn btn-sm" onclick="doSearch('tbl-services','search-services')"><i
                                class="bi bi-search"></i> Tìm</button>
                        <button class="btn btn-primary btn-sm" onclick="showAddDV()"><i class="bi bi-plus"></i> Thêm
                            dịch vụ</button>
                    </div>
                </div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Tên dịch vụ</th>
                                <th>Danh mục</th>
                                <th>Giá</th>
                                <th>Slot</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="tbl-services"></tbody>
                    </table>
                </div>
            </div>

            <!-- ═══ PORTFOLIO ═══ -->
            <div class="section" id="sec-portfolio">
                <div class="table-header">
                    <h3>Portfolio</h3>
                    <div class="filter-bar" style="margin-bottom:0">
                        <input class="search-input" id="search-portfolio" placeholder="Tìm tiêu đề..." />
                        <button class="btn btn-sm" onclick="doSearchPortfolio()"><i class="bi bi-search"></i>
                            Tìm</button>
                        <button class="btn btn-primary btn-sm" onclick="showAddPF()"><i class="bi bi-plus"></i> Thêm
                            ảnh</button>
                    </div>
                </div>
                <div class="portfolio-grid" id="portfolio-grid"></div>
            </div>

            <!-- ═══ ADDONS ═══ -->
            <div class="section" id="sec-addons">
                <div class="table-header">
                    <h3>Dịch vụ bổ sung</h3>
                    <div class="filter-bar" style="margin-bottom:0">
                        <input class="search-input" id="search-addons" placeholder="Tìm tên dịch vụ bổ sung..." />
                        <button class="btn btn-sm" onclick="doSearch('tbl-addons','search-addons')"><i
                                class="bi bi-search"></i> Tìm</button>
                        <button class="btn btn-primary btn-sm" onclick="showAddBS()"><i class="bi bi-plus"></i>
                            Thêm</button>
                    </div>
                </div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Tên</th>
                                <th>Mô tả</th>
                                <th>Giá</th>
                                <th>Dịch vụ gốc</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="tbl-addons"></tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>

    <!-- ═══ MODALS ═══ -->
    <div class="modal-overlay" id="modal-complete">
        <div class="modal">
            <div class="modal-head">
                <h3>Hoàn thành đơn</h3><button class="modal-close"
                    onclick="hideModal('modal-complete')">&times;</button>
            </div>
            <div class="modal-body"><input type="hidden" id="complete-id" />
                <div class="form-group"><label>Link ảnh bàn giao</label><input type="text" id="complete-link"
                        placeholder="https://..." /></div>
            </div>
            <div class="modal-foot"><button class="btn" onclick="hideModal('modal-complete')">Hủy</button><button
                    class="btn btn-primary" onclick="submitComplete()">Xác nhận</button></div>
        </div>
    </div>

    <div class="modal-overlay" id="modal-dv">
        <div class="modal">
            <div class="modal-head">
                <h3 id="modal-dv-title">Thêm dịch vụ</h3><button class="modal-close"
                    onclick="hideModal('modal-dv')">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="dv-mode" /><input type="hidden" id="dv-id" />
                <div class="form-group"><label>Tên dịch vụ</label><input type="text" id="dv-ten" /></div>
                <div class="form-group"><label>Danh mục</label><select id="dv-danhmuc"></select></div>
                <div class="form-group"><label>Giá tiền</label><input type="number" id="dv-gia" /></div>
                <div class="form-group"><label>Giới hạn thợ (slot)</label><input type="number" id="dv-slot" value="1" />
                </div>
                <div class="form-group"><label>Mô tả</label><textarea id="dv-mota"></textarea></div>
                <div class="form-group"><label>Link ảnh đại diện</label><input type="text" id="dv-anh" /></div>
            </div>
            <div class="modal-foot"><button class="btn" onclick="hideModal('modal-dv')">Hủy</button><button
                    class="btn btn-primary" onclick="submitDV()">Lưu</button></div>
        </div>
    </div>

    <div class="modal-overlay" id="modal-pf">
        <div class="modal">
            <div class="modal-head">
                <h3 id="modal-pf-title">Portfolio</h3><button class="modal-close"
                    onclick="hideModal('modal-pf')">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="pf-mode" /><input type="hidden" id="pf-id" />
                <div class="form-group"><label><i class="bi bi-fonts"></i> Tiêu đề</label><input type="text"
                        id="pf-tieude" placeholder="Nhập tiêu đề cho ảnh..." /></div>
                <div class="form-group"><label><i class="bi bi-tag"></i> Dịch vụ</label><select id="pf-dv"></select>
                </div>

                <div class="form-group">
                    <label><i class="bi bi-image"></i> Chọn ảnh Portfolio</label>
                    <div class="upload-zone" id="pf-upload-zone" onclick="document.getElementById('pf-file').click()">
                        <input type="file" id="pf-file" accept="image/*" style="display:none"
                            onchange="previewPFImage(this)" />
                        <div class="upload-placeholder" id="pf-placeholder">
                            <i class="bi bi-cloud-arrow-up"></i>
                            <p>Kéo thả ảnh hoặc nhấn để chọn</p>
                            <span>Hỗ trợ: JPG, PNG, WEBP (Max 5MB)</span>
                        </div>
                        <div class="upload-preview" id="pf-preview" style="display:none">
                            <img src="" id="pf-preview-img" />
                            <div class="preview-overlay"><i class="bi bi-arrow-repeat"></i> Thay đổi ảnh</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-foot"><button class="btn" onclick="hideModal('modal-pf')">Hủy</button><button
                    class="btn btn-primary" onclick="submitPF()">Lưu dữ liệu</button></div>
        </div>
    </div>

    <div class="modal-overlay" id="modal-bs">
        <div class="modal">
            <div class="modal-head">
                <h3 id="modal-bs-title">Dịch vụ bổ sung</h3><button class="modal-close"
                    onclick="hideModal('modal-bs')">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="bs-mode" /><input type="hidden" id="bs-id" />
                <div class="form-group"><label>Tên</label><input type="text" id="bs-ten" /></div>
                <div class="form-group"><label>Mô tả</label><textarea id="bs-mota"></textarea></div>
                <div class="form-group"><label>Giá tiền</label><input type="number" id="bs-gia" /></div>
                <div class="form-group"><label>Dịch vụ gốc</label><select id="bs-dv"></select></div>
            </div>
            <div class="modal-foot"><button class="btn" onclick="hideModal('modal-bs')">Hủy</button><button
                    class="btn btn-primary" onclick="submitBS()">Lưu</button></div>
        </div>
    </div>

    <div class="modal-overlay" id="modal-schedule">
        <div class="modal">
            <div class="modal-head">
                <h3 id="modal-schedule-title">Lên lịch chụp</h3><button class="modal-close"
                    onclick="hideModal('modal-schedule')">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="schedule-mode" />
                <input type="hidden" id="schedule-id" />
                <div class="form-group">
                    <label>Dịch vụ</label>
                    <select id="schedule-dv" required></select>
                </div>
                <div class="form-group">
                    <label>Ngày chụp</label>
                    <input type="date" id="schedule-ngay" required />
                </div>
                <div class="form-group">
                    <label>Số lịch tối đa</label>
                    <input type="number" id="schedule-solich" min="1" value="5" required />
                </div>
                <div class="form-group">
                    <label>Ghi chú</label>
                    <textarea id="schedule-ghichu" placeholder="VD: Địa điểm mặc định, yêu cầu đặc biệt..."></textarea>
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn" onclick="hideModal('modal-schedule')">Hủy</button>
                <button class="btn btn-primary" onclick="submitSchedule()">Lưu lịch</button>
            </div>
        </div>
    </div>

    <script>
        // ===== ADMIN JS INLINE =====
        var currentSection = 'dashboard', danhMucList = [];

        document.addEventListener('DOMContentLoaded', function () {
            loadDanhMuc();
            switchSection('dashboard');
        });

        // === NAV ===
        function switchSection(id) {
            currentSection = id;
            document.querySelectorAll('.section').forEach(function (s) { s.classList.remove('active') });
            document.querySelectorAll('.nav-item').forEach(function (n) { n.classList.remove('active') });
            var sec = document.getElementById('sec-' + id);
            if (sec) sec.classList.add('active');
            var nav = document.querySelector('[data-sec="' + id + '"]');
            if (nav) nav.classList.add('active');
            var t = document.getElementById('page-title');
            if (t && nav) t.textContent = nav.querySelector('span').textContent;

            if (id === 'dashboard') loadThongKe();
            else if (id === 'booking-pending') loadDatLich('chua_xac_nhan');
            else if (id === 'schedule') { loadScheduleServices(); loadSchedule(); }
            else if (id === 'booking-confirmed') loadDatLich('da_xac_nhan');
            else if (id === 'history') loadDatLich('hoan_thanh');
            else if (id === 'customers') loadKhachHang();
            else if (id === 'services') loadDichVu();
