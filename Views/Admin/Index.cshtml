        // === THONG KE ===
        function loadThongKe() {
            var yearEl = document.getElementById('revenue-year');
            var nam = yearEl ? yearEl.value : new Date().getFullYear();
            var url = '/Admin/GetThongKe?nam=' + nam;
            var dfEl = document.getElementById('revenue-day-from');
            var dtEl = document.getElementById('revenue-day-to');
            var dayFrom = dfEl ? dfEl.value : '';
            var dayTo = dtEl ? dtEl.value : '';
            var isDay = false;
            if (dayFrom) { url += '&ngayTu=' + dayFrom; isDay = true }
            if (dayTo) { url += '&ngayDen=' + dayTo; isDay = true }
            fetch(url).then(function (r) { return r.json() }).then(function (d) {
                if (!d.success) return;
                var rvt = document.getElementById('rv-total'); if (rvt) rvt.textContent = fmt(d.tongDoanhThu) + '\u0111';
                var rvb = document.getElementById('rv-booking'); if (rvb) rvb.textContent = d.tongDatLich;
                var rvc = document.getElementById('rv-cancel'); if (rvc) rvc.textContent = d.tongHuy;
                var rvs = document.getElementById('rv-star'); if (rvs) rvs.textContent = (parseFloat(d.tbSao) || 0).toFixed(1) + ' \u2605';
                var arr = d.doanhThuTheoThang || [];
                var max = 0; arr.forEach(function (m) { if ((m.doanhThu || 0) > max) max = m.doanhThu });
                if (max === 0) max = 1;
                var ch = '';
                arr.forEach(function (m) {
                    var h = Math.max(4, ((m.doanhThu || 0) / max) * 160);
                    var lbl = isDay ? 'N' + m.thang : 'T' + m.thang;
                    var val = (m.doanhThu > 0) ? fmt(Math.round(m.doanhThu / 1000)) + 'K' : '';
                    ch += '<div class="chart-bar" title="' + fmt(m.doanhThu) + '" style="height:' + h + 'px"><span class="bar-value">' + val + '</span><span class="bar-label">' + lbl + '</span></div>';
                });
                var ce = document.getElementById('revenue-chart'); if (ce) ce.innerHTML = ch || '<div style="padding:20px;color:#999;font-size:12px">Ch\u01B0a c\u00F3 d\u1EEF li\u1EC7u</div>';
                var dvArr = d.doanhThuTheoDV || []; var th = '';
                dvArr.forEach(function (s, i) { th += '<tr><td>' + (i + 1) + '</td><td>' + (s.tenDichVu || 'N/A') + '</td><td>' + fmt(s.tongTien) + '\u0111</td></tr>' });
                if (!dvArr.length) th = '<tr><td colspan="3" class="empty-state">Ch\u01B0a c\u00F3 d\u1EEF li\u1EC7u</td></tr>';
                var de = document.getElementById('tbl-revenue-dv'); if (de) de.innerHTML = th;
            }).catch(function (e) { console.error('GetThongKe:', e) });
        }
        function exportReport() {
