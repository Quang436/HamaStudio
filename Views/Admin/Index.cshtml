        // === FORMAT ===
        function fmt(n) { return new Intl.NumberFormat('vi-VN').format(n || 0) }
        function badge(tt) {
            if (!tt) return '';
            var t = tt.trim(); var cls = '';
            if (t.indexOf('Ch\u1EDD') > -1) cls = 'badge-wait';
            else if (t === 'Ho\u00E0n th\u00E0nh') cls = 'badge-done';
            else if (t.indexOf('x\u00E1c nh\u1EADn') > -1) cls = 'badge-confirmed';
            else if (t.indexOf('c\u1ECDc') > -1) cls = 'badge-deposit';
            else if (t.indexOf('h\u1EE7y') > -1) cls = 'badge-cancel';
            else if (t === 'Ho\u1EA1t \u0111\u1ED9ng') cls = 'badge-active';
            else if (t === 'Kh\u00F3a') cls = 'badge-locked';
            return '<span class="badge ' + cls + '">' + t + '</span>';
        }
        function esc(s) { return (s || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;') }

