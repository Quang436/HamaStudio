            var c = 'BAO CAO DOANH THU HAMA STUDIO - NAM ' + nam + '\r\nNgay xuat: ' + new Date().toLocaleString('vi-VN') + '\r\n';
            var el;
            el = document.getElementById('rv-total'); if (el) c += 'Tong doanh thu: ' + el.textContent + '\r\n';
            el = document.getElementById('rv-booking'); if (el) c += 'Tong lich dat: ' + el.textContent + '\r\n';
            el = document.getElementById('rv-cancel'); if (el) c += 'Da huy: ' + el.textContent + '\r\n';
            c += '\r\nCHI TIET DOANH THU THEO DICH VU\r\n';
            document.querySelectorAll('#tbl-revenue-dv tr').forEach(function (r) { var cells = r.querySelectorAll('td'); if (cells.length >= 3) c += cells[0].textContent + '. ' + cells[1].textContent + ': ' + cells[2].textContent + '\r\n' });
            var blob = new Blob(['\uFEFF' + c], { type: 'text/plain;charset=utf-8' });
