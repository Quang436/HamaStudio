@{
    ViewBag.Title = "My Profile | Hama Studio Member";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-dark: #1a1a1a;
        --accent-gold: #c5a880;
        --bg-soft: #fdfdfd;
        --text-muted: #6c757d;
        --card-radius: 12px;
        --transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
        font-family: 'Montserrat', sans-serif;
        background-color: var(--bg-soft);
        color: var(--primary-dark);
    }

    .serif {
        font-family: 'Playfair Display', serif;
    }

    /* ===== PROFILE HEADER ===== */
    .profile-header {
        padding: 60px 0;
        background: linear-gradient(to bottom, #f9f9f9, var(--bg-soft));
        border-bottom: 1px solid #eee;
        margin-bottom: 50px;
    }

    /* ===== SIDEBAR STYLES ===== */
    .auth-card {
        background: white;
        border-radius: var(--card-radius);
        padding: 30px;
        border: 1px solid #f0f0f0;
        box-shadow: 0 10px 30px rgba(0,0,0,0.02);
    }

    .profile-nav-link {
        display: flex;
        align-items: center;
        padding: 15px 25px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 600;
        transition: var(--transition);
        border-left: 3px solid transparent;
    }

        .profile-nav-link:hover {
            color: var(--primary-dark);
            background: #fcfcfc;
        }

        .profile-nav-link.active {
            color: var(--primary-dark);
            background: #fff9f0;
            border-left-color: var(--accent-gold);
        }

        .profile-nav-link i {
            font-size: 1.1rem;
            margin-right: 15px;
        }

    /* ===== FORM STYLES (Luxury Look) ===== */
    .auth-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 700;
        color: var(--text-muted);
        margin-bottom: 8px;
        display: block;
    }

    .auth-input {
        border: none;
        border-bottom: 1px solid #eee;
        border-radius: 0;
        padding: 10px 0;
        font-size: 0.95rem;
        background: transparent;
        width: 100%;
        outline: none;
        transition: var(--transition);
        font-weight: 500;
    }

        .auth-input:focus {
            border-color: var(--accent-gold);
        }

        .auth-input[readonly] {
            color: var(--text-muted);
            border-bottom-style: dashed;
        }

    /* ===== STATUS PILLS ===== */
    .status-badge {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 4px 12px;
        border-radius: 50px;
        letter-spacing: 1px;
    }

    .status-confirmed {
        background: #f4efe6;
        color: #a68b5b;
    }

    .status-pending {
        background: #f5f5f5;
        color: #999;
    }

    /* ===== BUTTONS ===== */
    .btn-gold-outline {
        border: 1px solid var(--accent-gold);
        color: var(--accent-gold);
        background: transparent;
        padding: 8px 20px;
        border-radius: 4px;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: var(--transition);
    }

        .btn-gold-outline:hover {
            background: var(--accent-gold);
            color: white;
        }

    .btn-premium-save {
        background: var(--primary-dark);
        color: white;
        padding: 15px 40px;
        border-radius: 4px;
        border: none;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        transition: var(--transition);
    }

        .btn-premium-save:hover {
            background: var(--accent-gold);
            transform: translateY(-2px);
        }
</style>

<div class="profile-header">
    <div class="container">
        <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 4px; color: var(--accent-gold); font-weight: 700;">Account</span>
        <h1 class="serif display-4 fw-bold mt-2 mb-0">Hồ sơ cá nhân</h1>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-5">
        <div class="col-lg-3">
            <div class="auth-card text-center mb-4">
                <div class="position-relative d-inline-block mb-3">
                    <img src="https://i.pravatar.cc/150?u=hama_user_1" alt="Avatar"
                         class="rounded-circle shadow-sm" width="100" height="100"
                         style="object-fit:cover; border: 4px solid #fff; outline: 1px solid #eee;" />
                    <button class="btn btn-dark rounded-circle position-absolute bottom-0 end-0 p-0 d-flex align-items-center justify-content-center"
                            style="width:32px; height:32px; border: 2px solid #fff;">
                        <i class="bi bi-camera-fill" style="font-size: 0.8rem;"></i>
                    </button>
                </div>
                <h5 class="serif fw-bold mb-1">Nguyễn Văn A</h5>
                <p class="text-muted" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;">Premium Member</p>
            </div>

            <div class="auth-card p-0 overflow-hidden">
                <div class="py-2">
                    <a href="/Account/Profile" class="profile-nav-link active">
                        <i class="bi bi-person-bounding-box"></i> Thông tin cá nhân
                    </a>
                    <a href="/Booking/MyBookings" class="profile-nav-link">
                        <i class="bi bi-collection-play"></i> Lịch đã đặt
                    </a>
                    <a href="#" class="profile-nav-link">
                        <i class="bi bi-bell"></i> Thông báo
                    </a>
                    <a href="#" class="profile-nav-link">
                        <i class="bi bi-shield-check"></i> Bảo mật & OTP
                    </a>
                    <div style="height: 1px; background: #eee; margin: 10px 25px;"></div>
                    <a href="/Account/Login" class="profile-nav-link text-danger">
                        <i class="bi bi-power"></i> Đăng xuất
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="auth-card mb-5">
                <div class="d-flex align-items-center justify-content-between mb-5">
                    <h4 class="serif fw-bold m-0">Chi tiết tài khoản</h4>
                    <button class="btn-gold-outline" id="editBtn" onclick="enableEdit()">Chỉnh sửa thông tin</button>
                </div>

                <form action="/Account/Update" method="post">
                    <div class="row g-5">
                        <div class="col-md-6">
                            <label class="auth-label">Họ và tên lót</label>
                            <input type="text" class="auth-input" value="Nguyễn" name="FirstName" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="auth-label">Tên người dùng</label>
                            <input type="text" class="auth-input" value="Văn A" name="LastName" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="auth-label">Địa chỉ Email</label>
                            <input type="email" class="auth-input" value="nguyenvana@email.com" name="Email" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="auth-label">Số điện thoại (MaXacThuc)</label>
                            <input type="tel" class="auth-input" value="+84 336 486 377" name="Phone" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="auth-label">Giới tính</label>
                            <select class="auth-input" name="Gender" disabled style="border-radius: 0; appearance: none;">
                                <option value="Nam" selected>Nam</option>
                                <option value="Nu">Nữ</option>
                                <option value="Khac">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="auth-label">Ngày sinh</label>
                            <input type="date" class="auth-input" value="1995-12-01" name="DOB" readonly />
                        </div>
                        <div class="col-12">
                            <label class="auth-label">Địa chỉ thường trú</label>
                            <input type="text" class="auth-input" value="123 Võ Nguyên Giáp, Đà Nẵng, Việt Nam" name="Address" readonly />
                        </div>
                    </div>

                    <div id="saveBtnWrapper" class="mt-5 text-end" style="display: none;">
                        <button type="button" class="btn btn-link text-muted text-decoration-none me-3" onclick="disableEdit()">Hủy bỏ</button>
                        <button type="submit" class="btn-premium-save shadow-lg">Lưu thay đổi</button>
                    </div>
                </form>
            </div>

            <div class="auth-card">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h5 class="serif fw-bold m-0">Hoạt động gần đây</h5>
                    <a href="/Booking/MyBookings" class="small fw-bold text-dark text-uppercase ls-1 text-decoration-none">
                        Xem tất cả <i class="bi bi-chevron-right ms-1" style="font-size: 0.7rem;"></i>
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-borderless align-middle" style="min-width: 600px;">
                        <thead class="border-bottom">
                            <tr class="text-muted small text-uppercase ls-1">
                                <th class="ps-0 py-3">Dịch vụ</th>
                                <th class="py-3">Ngày chụp</th>
                                <th class="py-3">Trạng thái</th>
                                <th class="text-end pe-0 py-3">Tổng tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-0 py-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?w=100" class="rounded-3" width="45" height="45" style="object-fit: cover;" />
                                        <div>
                                            <p class="fw-bold mb-0">Phóng Sự Cưới</p>
                                            <span class="text-muted" style="font-size: 10px;">ID: LD8821</span>
                                        </div>
                                    </div>
                                </td>
                                <td><p class="mb-0 small fw-medium">01/12/2026</p><span class="text-muted small">08:00</span></td>
                                <td><span class="status-badge status-confirmed">Đã xác nhận</span></td>
                                <td class="text-end pe-0 fw-bold">15.000.000 ₫</td>
                            </tr>
                            <tr>
                                <td class="ps-0 py-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="https://images.unsplash.com/photo-1609220136736-443140cffec6?w=100" class="rounded-3" width="45" height="45" style="object-fit: cover;" />
                                        <div>
                                            <p class="fw-bold mb-0">Gia Đình Ngoại Cảnh</p>
                                            <span class="text-muted" style="font-size: 10px;">ID: LD8845</span>
                                        </div>
                                    </div>
                                </td>
                                <td><p class="mb-0 small fw-medium">15/12/2026</p><span class="text-muted small">16:00</span></td>
                                <td><span class="status-badge status-pending">Chờ xác nhận</span></td>
                                <td class="text-end pe-0 fw-bold">5.000.000 ₫</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    function enableEdit() {
        document.querySelectorAll('.auth-input').forEach(input => {
            input.removeAttribute('readonly');
            input.removeAttribute('disabled');
        });
        document.getElementById('editBtn').style.display = 'none';
        document.getElementById('saveBtnWrapper').style.display = 'block';
        document.querySelector('.auth-input').focus();
    }

    function disableEdit() {
        // Reload lại trang để hủy các thay đổi đã nhập
        location.reload();
    }
    </script>
}