@{
    ViewBag.Title = "Login | Hama Studio Reservation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-dark: #1a1a1a;
        --accent-gold: #c5a880;
        --bg-soft: #fdfdfd;
        --text-muted: #6c757d;
        --card-radius: 12px;
        --transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
        font-family: 'Montserrat', sans-serif;
        background-color: var(--bg-soft);
        color: var(--primary-dark);
    }

    .serif {
        font-family: 'Playfair Display', serif;
    }

    /* ===== AUTH CARD LUXURY ===== */
    .auth-card {
        background: white;
        border-radius: var(--card-radius);
        padding: 45px;
        border: 1px solid #f0f0f0;
        box-shadow: 0 20px 50px rgba(0,0,0,0.03);
    }

    /* ===== LUXURY INPUTS ===== */
    .auth-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 700;
        color: var(--text-muted);
        margin-bottom: 8px;
        display: block;
    }

    .auth-input {
        border: none;
        border-bottom: 1px solid #eee;
        border-radius: 0;
        padding: 12px 0;
        font-size: 0.95rem;
        background: transparent;
        width: 100%;
        outline: none;
        transition: var(--transition);
    }

        .auth-input:focus {
            border-color: var(--accent-gold);
        }

    /* Nút ẩn/hiện mật khẩu */
    .btn-eye {
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--text-muted);
        padding: 5px;
        transition: 0.2s;
    }

        .btn-eye:hover {
            color: var(--accent-gold);
        }

    /* ===== BUTTONS ===== */
    .btn-premium {
        background: var(--primary-dark);
        color: white;
        border: none;
        padding: 16px;
        border-radius: 8px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        width: 100%;
        transition: var(--transition);
        font-size: 0.85rem;
    }

        .btn-premium:hover {
            background: var(--accent-gold);
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(197, 168, 128, 0.2);
        }

    .btn-social {
        background: white;
        border: 1px solid #eee;
        border-radius: 8px;
        padding: 12px;
        font-size: 0.85rem;
        font-weight: 600;
        transition: var(--transition);
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 10px;
    }

        .btn-social:hover {
            border-color: var(--primary-dark);
            background: #fafafa;
        }

    .divider-text {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #ccc;
    }
</style>

<div class="container py-5" style="min-height: 80vh; display: flex; align-items: center;">
    <div class="row justify-content-center w-100 m-0">
        <div class="col-md-6 col-lg-4">

            <div class="text-center mb-5">
                <a href="/" class="text-decoration-none">
                    <h1 class="serif fw-bold mb-1" style="font-size: 1.8rem; color: var(--primary-dark); letter-spacing: 2px;">HAMA STUDIO</h1>
                </a>
                <span style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 4px; color: var(--accent-gold); font-weight: 700;">Account Login</span>
            </div>

            <div class="auth-card">
                <h2 class="serif fw-bold mb-2" style="font-size: 1.5rem;">Chào mừng trở lại</h2>
                <p class="text-muted small mb-5">Nhập thông tin tài khoản để tiếp tục trải nghiệm nghệ thuật tại Hama.</p>

                <form action="/Account/Login" method="post">
                    @Html.AntiForgeryToken()

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger small">@ViewBag.Error</div>
                    }

                    <div class="mb-4">
                        <label class="auth-label">Tên đăng nhập</label>
                        <input type="text" name="TenDangNhap" class="auth-input" placeholder="Tên đăng nhập" required />
                    </div>

                    <div class="mb-2">
                        <label class="auth-label">Mật khẩu</label>
                        <div class="position-relative">
                            <input type="password" name="MatKhau" id="pwdInput" class="auth-input" placeholder="••••••••" required />
                            <button type="button" class="btn-eye" onclick="togglePwd()">
                                <i class="bi bi-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="text-end mb-5">
                        <a href="#" class="text-muted small text-decoration-none" style="font-size: 0.75rem; border-bottom: 1px solid #eee;">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn-premium mb-4 shadow-sm">ĐĂNG NHẬP</button>
                </form>

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="flex-grow-1" style="height: 1px; background: #eee;"></div>
                    <span class="divider-text">hoặc</span>
                    <div class="flex-grow-1" style="height: 1px; background: #eee;"></div>
                </div>

                <div class="social-login">
                    <button class="btn-social">
                        <img src="https://www.google.com/favicon.ico" width="16" alt="Google" />
                        Tiếp tục với Google
                    </button>
                    <button class="btn-social">
                        <i class="bi bi-facebook text-primary"></i>
                        Tiếp tục với Facebook
                    </button>
                </div>
            </div>

            <p class="text-center mt-5 small text-muted">
                Bạn chưa có tài khoản?
                <a href="/Account/Register" class="fw-bold text-dark text-decoration-none" style="border-bottom: 1px solid var(--accent-gold);">Đăng ký thành viên</a>
            </p>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePwd() {
            var input = document.getElementById('pwdInput');
            var icon = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
}