@{
    ViewBag.Title = "Register | Hama Studio Member";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-dark: #1a1a1a;
        --accent-gold: #c5a880;
        --bg-soft: #fdfdfd;
        --text-muted: #6c757d;
        --card-radius: 12px;
        --transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
        font-family: 'Montserrat', sans-serif;
        background-color: var(--bg-soft);
        color: var(--primary-dark);
    }

    .serif {
        font-family: 'Playfair Display', serif;
    }

    /* ===== AUTH CARD LUXURY ===== */
    .auth-card {
        background: white;
        border-radius: var(--card-radius);
        padding: 45px;
        border: 1px solid #f0f0f0;
        box-shadow: 0 20px 50px rgba(0,0,0,0.03);
    }

    /* ===== LUXURY INPUTS ===== */
    .auth-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 700;
        color: var(--text-muted);
        margin-bottom: 8px;
        display: block;
    }

    .auth-input {
        border: none;
        border-bottom: 1px solid #eee;
        border-radius: 0;
        padding: 10px 0;
        font-size: 0.9rem;
        background: transparent;
        width: 100%;
        outline: none;
        transition: var(--transition);
        font-weight: 500;
    }

        .auth-input:focus {
            border-color: var(--accent-gold);
        }

    /* Password Eye Button */
    .btn-eye {
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--text-muted);
        padding: 5px;
        transition: 0.2s;
    }

        .btn-eye:hover {
            color: var(--accent-gold);
        }

    /* Custom Checkbox Style */
    .form-check-input:checked {
        background-color: var(--primary-dark);
        border-color: var(--primary-dark);
    }

    /* ===== BUTTONS ===== */
    .btn-premium {
        background: var(--primary-dark);
        color: white;
        border: none;
        padding: 16px;
        border-radius: 8px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        width: 100%;
        transition: var(--transition);
        font-size: 0.85rem;
    }

        .btn-premium:hover {
            background: var(--accent-gold);
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(197, 168, 128, 0.2);
        }

    .text-xs {
        font-size: 0.75rem;
    }

    .ls-1 {
        letter-spacing: 1px;
    }
</style>

<div class="container py-5" style="min-height: 90vh; display: flex; align-items: center;">
    <div class="row justify-content-center w-100 m-0">
        <div class="col-md-7 col-lg-5 col-xl-4">

            <div class="text-center mb-5">
                <a href="/" class="text-decoration-none">
                    <h1 class="serif fw-bold mb-1" style="font-size: 1.8rem; color: var(--primary-dark); letter-spacing: 2px;">HAMA STUDIO</h1>
                </a>
                <span style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 4px; color: var(--accent-gold); font-weight: 700;">Join our Art Community</span>
            </div>

            <div class="auth-card">
                <h2 class="serif fw-bold mb-2" style="font-size: 1.5rem;">Tạo tài khoản</h2>
                <p class="text-muted small mb-5">Bắt đầu hành trình lưu giữ những khoảnh khắc tuyệt vời nhất cùng chúng tôi.</p>

                <form action="/Account/Register" method="post">
                    @Html.AntiForgeryToken()

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger small">@ViewBag.Error</div>
                    }

                    <div class="row g-4 mb-4">
                        <div class="col-6">
                            <label class="auth-label">Họ</label>
                            <input type="text" name="lastName" class="auth-input" placeholder="Nguyễn" required />
                        </div>
                        <div class="col-6">
                            <label class="auth-label">Tên</label>
                            <input type="text" name="firstName" class="auth-input" placeholder="Văn A" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="auth-label">Tên đăng nhập</label>
                        <input type="text" name="TenDangNhap" class="auth-input" placeholder="VD: van_a_123" required />
                    </div>

                    <div class="mb-4">
                        <label class="auth-label">Địa chỉ Email</label>
                        <input type="email" name="Email" class="auth-input" placeholder="example@email.com" required />
                    </div>

                    <div class="mb-4">
                        <label class="auth-label">Mật khẩu</label>
                        <div class="position-relative">
                            <input type="password" name="MatKhau" id="pwdInput" class="auth-input" placeholder="Tối thiểu 8 ký tự" required />
                            <button type="button" class="btn-eye" onclick="togglePwd('pwdInput','eyeIcon1')">
                                <i class="bi bi-eye" id="eyeIcon1"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-5">
                        <label class="auth-label">Xác nhận mật khẩu</label>
                        <div class="position-relative">
                            <input type="password" name="confirmPassword" id="pwdInput2" class="auth-input" placeholder="Nhập lại mật khẩu" required />
                            <button type="button" class="btn-eye" onclick="togglePwd('pwdInput2','eyeIcon2')">
                                <i class="bi bi-eye" id="eyeIcon2"></i>
                            </button>
                        </div>
                    </div>

                    <div class="d-flex gap-3 align-items-start mb-5">
                        <input type="checkbox" id="terms" class="form-check-input mt-1" required />
                        <label for="terms" class="text-xs text-muted lh-base">
                            Tôi đồng ý với <a href="#" class="text-dark fw-bold text-decoration-none border-bottom border-secondary">Điều khoản dịch vụ</a>
                            và <a href="#" class="text-dark fw-bold text-decoration-none border-bottom border-secondary">Chính sách bảo mật</a> của Hama.
                        </label>
                    </div>
                    <div id="registerErrorBox" class="alert alert-danger small d-none" style="border-radius:8px; font-size:0.8rem; line-height:1.6;"></div>

                    <button type="submit" class="btn-premium shadow-sm">TẠO TÀI KHOẢN THÀNH VIÊN</button>
                </form>
            </div>

            <p class="text-center mt-5 small text-muted">
                Đã có tài khoản?
                <a href="/Account/Login" class="fw-bold text-dark text-decoration-none" style="border-bottom: 1px solid var(--accent-gold);">Đăng nhập ngay</a>
            </p>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePwd(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        // ==================== CLIENT-SIDE VALIDATION ====================
        (function() {
            var form = document.querySelector('form[action="/Account/Register"]');
            if (!form) return;

            form.addEventListener('submit', function(e) {
                var errorBox = document.getElementById('registerErrorBox');
                var errors = [];

                // Xóa highlight cũ
                form.querySelectorAll('.auth-input').forEach(function(inp) {
                    inp.style.borderBottomColor = '#eee';
                });

                var lastName = form.querySelector('[name="lastName"]');
                var firstName = form.querySelector('[name="firstName"]');
                var username = form.querySelector('[name="TenDangNhap"]');
                var email = form.querySelector('[name="Email"]');
                var password = form.querySelector('[name="MatKhau"]');
                var confirmPwd = form.querySelector('[name="confirmPassword"]');
                var terms = document.getElementById('terms');

                if (!lastName.value.trim()) {
                    errors.push('Vui lòng nhập <strong>Họ</strong>.');
                    lastName.style.borderBottomColor = '#e74c3c';
                }
                if (!firstName.value.trim()) {
                    errors.push('Vui lòng nhập <strong>Tên</strong>.');
                    firstName.style.borderBottomColor = '#e74c3c';
                }
                if (!username.value.trim()) {
                    errors.push('Vui lòng nhập <strong>Tên đăng nhập</strong>.');
                    username.style.borderBottomColor = '#e74c3c';
                }
                if (!email.value.trim()) {
                    errors.push('Vui lòng nhập <strong>Địa chỉ Email</strong>.');
                    email.style.borderBottomColor = '#e74c3c';
                } else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email.value.trim())) {
                    errors.push('Địa chỉ <strong>Email</strong> không hợp lệ.');
                    email.style.borderBottomColor = '#e74c3c';
                }
                if (!password.value) {
                    errors.push('Vui lòng nhập <strong>Mật khẩu</strong>.');
                    password.style.borderBottomColor = '#e74c3c';
                } else if (password.value.length < 6) {
                    errors.push('Mật khẩu phải có ít nhất <strong>6 ký tự</strong>.');
                    password.style.borderBottomColor = '#e74c3c';
                }
                if (!confirmPwd.value) {
                    errors.push('Vui lòng nhập <strong>Xác nhận mật khẩu</strong>.');
                    confirmPwd.style.borderBottomColor = '#e74c3c';
                } else if (password.value !== confirmPwd.value) {
                    errors.push('<strong>Mật khẩu xác nhận</strong> không khớp.');
                    confirmPwd.style.borderBottomColor = '#e74c3c';
                }
                if (!terms.checked) {
                    errors.push('Bạn cần đồng ý với <strong>Điều khoản dịch vụ</strong> và Chính sách bảo mật.');
                }

                if (errors.length > 0) {
                    e.preventDefault();
                    errorBox.innerHTML = '<i class="bi bi-exclamation-circle-fill me-1"></i>' + errors.join('<br><i class="bi bi-exclamation-circle-fill me-1"></i>');
                    errorBox.classList.remove('d-none');
                    errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                } else {
                    errorBox.classList.add('d-none');
                }
            });
        })();
    </script>
}