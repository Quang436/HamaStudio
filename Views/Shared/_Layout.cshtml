<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Hama Studio</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,600;0,700;1,500&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --primary-dark: #1a1a1a;
            --accent-gold: #c5a880;
            --bg-soft: #fdfdfd;
            --text-muted: #6c757d;
            --transition: all 0.3s ease;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            color: var(--primary-dark);
            background-color: var(--bg-soft);
        }

        .serif {
            font-family: 'Playfair Display', serif;
        }

        /* ===== HEADER / NAVBAR ===== */
        .navbar {
            padding: 20px 0;
            background-color: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
            transition: var(--transition);
            z-index: 1080 !important;
        }

        .navbar-brand {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 1.5rem;
            letter-spacing: -0.5px;
            color: var(--primary-dark) !important;
        }

        .nav-link-custom {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-muted) !important;
            padding: 10px 15px !important;
            position: relative;
            transition: var(--transition);
        }

            .nav-link-custom:hover, .nav-link-custom.active {
                color: var(--primary-dark) !important;
            }

            .nav-link-custom::after {
                content: '';
                position: absolute;
                bottom: 5px;
                left: 50%;
                width: 0;
                height: 1px;
                background-color: var(--accent-gold);
                transition: var(--transition);
                transform: translateX(-50%);
            }

            .nav-link-custom:hover::after, .nav-link-custom.active::after {
                width: 20px;
            }

        .btn-booking {
            background-color: var(--primary-dark);
            color: white !important;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-radius: 4px; /* Bo góc nhẹ đồng bộ */
            padding: 10px 25px !important;
            transition: var(--transition);
        }

            .btn-booking:hover {
                background-color: var(--accent-gold);
                transform: translateY(-2px);
            }

        .nav-icon-btn {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: var(--transition);
            color: var(--primary-dark) !important;
        }

        .nav-icon-btn:hover {
            background-color: #f0f0f0;
        }

        /* ===== FOOTER ===== */
        footer {
            background-color: #f9f9f9;
            border-top: 1px solid #eee;
        }

        .footer-title {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 1.2rem;
            margin-bottom: 25px;
        }

        .footer-link {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            transition: var(--transition);
            display: inline-block;
            margin-bottom: 10px;
        }

            .footer-link:hover {
                color: var(--accent-gold);
                transform: translateX(5px);
            }

        .footer-social a {
            width: 35px;
            height: 35px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #ddd;
            border-radius: 50%;
            color: var(--primary-dark);
            margin-right: 10px;
            transition: var(--transition);
            text-decoration: none;
        }

            .footer-social a:hover {
                background-color: var(--primary-dark);
                color: white;
                border-color: var(--primary-dark);
            }

        .contact-item {
            font-size: 0.85rem;
            margin-bottom: 12px;
            color: var(--text-muted);
        }

            .contact-item i {
                color: var(--accent-gold);
                width: 25px;
            }

        .divider {
            height: 1px;
            background-color: #eee;
            margin: 40px 0;
        }
    </style>
</head>
<body>

    @{
        var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <nav class="navbar navbar-expand-lg sticky-top border-bottom">
        <div class="container">
            <a class="navbar-brand" href="/">HAMA STUDIO</a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom @(ctrl == "Home" && action == "Index" ? "active" : "")" href="/">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom @(action == "About" ? "active" : "")" href="/Home/About">Giới thiệu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom @(action == "Portfolio" ? "active" : "")" href="/Home/Portfolio">Portfolio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom @(action == "Gallery" ? "active" : "")" href="/Home/Gallery">Gallery</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom @(action == "Services" ? "active" : "")" href="/Home/Services">Dịch vụ</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    @if (Session["UserId"] != null)
                    {
                        <!-- Khi đã đăng nhập -->
                        <div class="dropdown">
                            <a href="#" class="text-dark nav-icon-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Tài khoản của tôi">
                                <i class="bi bi-person-check-fill fs-5 text-success"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="min-width: 200px;">
                                <li class="px-3 py-2 border-bottom">
                                    <span class="small fw-bold text-muted">Xin chào,</span><br/>
                                    <strong>@(Session["FullName"] ?? Session["Username"])</strong>
                                </li>
                                <li><a class="dropdown-item small py-2" href="/Booking/MyBookings"><i class="bi bi-calendar2-check me-2"></i> Lịch đã đặt</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item small py-2 text-danger" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <!-- Khi chưa đăng nhập -->
                        <a href="/Account/Login" class="text-dark nav-icon-btn" title="Đăng nhập">
                            <i class="bi bi-person fs-5"></i>
                        </a>
                        <a href="/Booking/MyBookings" class="text-dark nav-icon-btn" title="Lịch đã đặt">
                            <i class="bi bi-calendar2-check fs-5"></i>
                        </a>
                    }
                    
                    <a href="/Booking" class="btn btn-booking">Đặt lịch chụp</a>
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="pt-5 pb-4">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4">
                    <p class="footer-title">Hama Studio</p>
                    <p class="text-muted small mb-4" style="line-height: 1.8; max-width: 300px;">
                        Kiến tạo những di sản hình ảnh vượt thời gian. Hama Studio là nơi câu chuyện của bạn trở thành nghệ thuật qua lăng kính chuyên nghiệp.
                    </p>
                    <div class="footer-social">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-youtube"></i></a>
                        <a href="#"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <p class="fw-bold small text-uppercase ls-1 mb-4">Khám phá</p>
                    <ul class="list-unstyled">
                        <li><a href="/" class="footer-link">Trang chủ</a></li>
                        <li><a href="/Home/About" class="footer-link">Giới thiệu</a></li>
                        <li><a href="/Home/Portfolio" class="footer-link">Portfolio</a></li>
                        <li><a href="/Home/Gallery" class="footer-link">Gallery</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-3">
                    <p class="fw-bold small text-uppercase ls-1 mb-4">Thông tin</p>
                    <ul class="list-unstyled">
                        <li class="contact-item"><i class="bi bi-geo-alt"></i> Đà Nẵng, Việt Nam</li>
                        <li class="contact-item"><i class="bi bi-telephone"></i> +84 336 486 377</li>
                        <li class="contact-item"><i class="bi bi-envelope"></i> hello@hamastudio.vn</li>
                        <li class="contact-item"><i class="bi bi-clock"></i> 08:00 - 21:00 (Hằng ngày)</li>
                    </ul>
                </div>

                <div class="col-lg-3">
                    <p class="fw-bold small text-uppercase ls-1 mb-4">Đối tác nghệ thuật</p>
                    <ul class="list-unstyled">
                        <li><a href="#" class="footer-link">ThuLê Makeup Artist</a></li>
                        <li><a href="#" class="footer-link">Hama Bridal Concept</a></li>
                        <li><a href="#" class="footer-link">Phục trang Trần Phú</a></li>
                        <li><a href="/Booking" class="footer-link fw-bold" style="color: var(--accent-gold);">Trở thành khách hàng</a></li>
                    </ul>
                </div>
            </div>

            <div class="divider"></div>

            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
                <p class="text-muted" style="font-size: 0.7rem;">&copy; @DateTime.Now.Year HAMA STUDIO. BẢO LƯU MỌI QUYỀN.</p>
                <p class="text-muted" style="font-size: 0.7rem;">
                    Dự án nghệ thuật được phát triển với <i class="bi bi-heart-fill text-danger mx-1"></i> tại Đà Nẵng
                </p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>