                    <!-- Phương thức thanh toán -->
                    <h5 class="serif fw-bold mb-4 border-bottom pb-2">2. Chọn phương thức chuyển tiền</h5>
                    <div class="d-flex flex-column gap-3 mb-4">
                        <button type="button" class="payment-method-btn active" id="payMethodQR" onclick="selectPhuongThuc('Chuyển khoản QR')">
