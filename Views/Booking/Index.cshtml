                                <div class="col-6">
                                    <label class="small fw-bold text-muted d-block mb-1">Hạn sử dụng</label>
                                    <input type="text" class="form-control" placeholder="MM/YY" style="border-radius:6px; font-size:0.85rem;" />
                                </div>
                                <div class="col-6">
                                    <label class="small fw-bold text-muted d-block mb-1">Mã bảo mật CVV</label>
                                    <input type="password" class="form-control" placeholder="123" style="border-radius:6px; font-size:0.85rem;" />
                                </div>
