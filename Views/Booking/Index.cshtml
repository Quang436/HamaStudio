@{
    ViewBag.Title = "Đặt lịch & Thanh toán | Hama Studio Experience";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<style>
    :root {
        --primary-dark: #1a1a1a;
        --accent-gold: #c5a880;
        --bg-soft: #fdfdfd;
        --text-muted: #6c757d;
        --btn-radius: 8px;
        --card-radius: 16px;
        --transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
        font-family: 'Montserrat', sans-serif;
        background-color: var(--bg-soft);
        color: var(--primary-dark);
    }

    .serif {
        font-family: 'Playfair Display', serif;
    }

    /* ===== PROGRESS BAR ===== */
    .booking-progress-container {
        max-width: 600px;
        margin: 0 auto 40px;
    }

    .progress-step-bar {
        position: relative;
        display: flex;
        justify-content: space-between;
    }

    .progress-step-bar::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        height: 2px;
        width: 100%;
        background: #e2e2e2;
        z-index: 1;
        transform: translateY(-50%);
    }

    .progress-line-fill {
        position: absolute;
        top: 50%;
        left: 0;
        height: 2px;
        width: 0%;
        background: var(--accent-gold);
        z-index: 1;
        transform: translateY(-50%);
        transition: width 0.4s ease;
    }

    .step-item {
        position: relative;
        z-index: 2;
        background: var(--bg-soft);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 2px solid #e2e2e2;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        transition: var(--transition);
        color: var(--text-muted);
    }

    .step-item.active {
        border-color: var(--accent-gold);
        background: var(--primary-dark);
        color: white;
    }

    .step-item.completed {
        border-color: var(--accent-gold);
        background: var(--accent-gold);
        color: white;
    }

    .step-label-custom {
        position: absolute;
        top: 45px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        white-space: nowrap;
        color: var(--text-muted);
        transition: var(--transition);
    }

    .step-item.active .step-label-custom {
        color: var(--primary-dark);
    }

    /* ===== SEARCH & CARDS ===== */
    .search-wrapper {
        position: relative;
        max-width: 100%;
        margin-bottom: 25px;
    }

    .search-input {
        width: 100%;
        padding: 14px 20px 14px 50px;
        border-radius: 30px;
        border: 1px solid #e0e0e0;
        background: white;
        font-size: 0.85rem;
        transition: var(--transition);
        outline: none;
    }

    .search-input:focus {
        border-color: var(--accent-gold);
        box-shadow: 0 10px 25px rgba(197, 168, 128, 0.1);
    }

    .search-icon {
        position: absolute;
        left: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--accent-gold);
        font-size: 1rem;
    }

    .booking-pkg-card {
        background: white;
        border: 1px solid #eee;
        border-radius: var(--card-radius);
        overflow: hidden;
        transition: var(--transition);
        cursor: pointer;
        display: flex;
        height: 140px;
        align-items: stretch;
    }

    .booking-pkg-card img {
        width: 140px;
        min-width: 140px;
        height: 100%;
        object-fit: cover;
        transition: var(--transition);
    }

    .pkg-content {
        padding: 15px 20px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        flex-grow: 1;
        overflow: hidden;
    }

    .booking-pkg-card:hover {
        border-color: var(--accent-gold);
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.03);
    }

    .booking-pkg-card.selected {
        border: 2px solid var(--accent-gold);
        background: #fdfaf6;
    }

    .booking-pkg-card.selected img {
        filter: brightness(0.95);
    }

    /* ===== INPUTS & EXTRAS ===== */
    .input-luxury {
        border: none;
        border-bottom: 1.5px solid #eee;
        padding: 12px 0;
        font-size: 0.95rem;
        background: transparent;
        width: 100%;
        outline: none;
        transition: var(--transition);
        font-weight: 500;
    }

    /* Fallback: Hide Google Maps error watermark to allow manual typing */
    .pac-target-input {
        background-image: none !important;
    }

    /* ===== CUSTOM MODAL ===== */
    .custom-modal-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.4);
        display: flex; align-items: center; justify-content: center;
        z-index: 9999;
        opacity: 0; visibility: hidden;
        transition: all 0.3s ease;
        backdrop-filter: blur(4px);
    }
    .custom-modal-overlay.active {
        opacity: 1; visibility: visible;
    }
    .custom-modal-box {
        background: #fff; padding: 40px 30px; border-radius: 16px;
        text-align: center; max-width: 380px; width: 90%;
        transform: translateY(-20px) scale(0.95);
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
    }
    .custom-modal-overlay.active .custom-modal-box {
        transform: translateY(0) scale(1);
    }

    .input-luxury:focus {
        border-color: var(--accent-gold);
    }

    .extra-item {
        padding: 15px;
        border: 1px solid #eee;
        border-radius: var(--btn-radius);
        transition: var(--transition);
        cursor: pointer;
        background: white;
    }

    .extra-item:hover {
        border-color: var(--accent-gold);
        background: #fcfbf9;
    }

    /* ===== TIME & CALENDAR ===== */
    .sidebar-box {
        background: white;
        border-radius: var(--card-radius);
        padding: 35px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.03);
        border: 1px solid #f0f0f0;
    }

    .cal-day {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: transparent;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 3px auto;
        transition: var(--transition);
        font-weight: 600;
    }

    .cal-day:hover:not(:disabled) {
        background: #f0f0f0;
    }

    .cal-day.selected {
        background: var(--primary-dark) !important;
        color: white !important;
    }

    .cal-day.today {
        color: var(--accent-gold);
        font-weight: 700;
        border: 1px solid var(--accent-gold);
    }

    .time-slot {
        background: #f8f9fa;
        border: 1px solid #eee;
        border-radius: var(--btn-radius);
        padding: 10px;
        font-size: 0.8rem;
        font-weight: 600;
        width: 100%;
        transition: var(--transition);
    }

    .time-slot:hover {
        border-color: var(--accent-gold);
        background: white;
    }

    .time-slot.selected {
        background: var(--primary-dark);
        color: white;
        border-color: var(--primary-dark);
    }

    /* ===== PAYMENT SELECTION ===== */
    .pay-card-option {
        border: 1.5px solid #eee;
        border-radius: var(--card-radius);
        padding: 25px;
        cursor: pointer;
        transition: var(--transition);
        background: white;
        position: relative;
        overflow: hidden;
    }

    .pay-card-option:hover {
        border-color: var(--accent-gold);
        transform: translateY(-3px);
    }

    .pay-card-option.active {
        border-color: var(--accent-gold);
        background: #fdfbf7;
    }

    .pay-card-option.active::after {
        content: '\eb7a';
        font-family: 'bootstrap-icons';
        position: absolute;
        top: 15px;
        right: 15px;
        color: var(--accent-gold);
        font-size: 1.2rem;
    }

    .payment-method-btn {
        border: 1px solid #ddd;
        background: white;
        padding: 15px;
        border-radius: var(--btn-radius);
        display: flex;
        align-items: center;
        gap: 15px;
        cursor: pointer;
        transition: var(--transition);
        width: 100%;
        text-align: left;
    }

    .payment-method-btn:hover {
        border-color: var(--accent-gold);
        background: #fafaf8;
    }

    .payment-method-btn.active {
        border-color: var(--accent-gold);
        background: #fdfaf5;
        font-weight: 600;
    }

    /* ===== BTNS ===== */
    .btn-premium {
        background: var(--primary-dark);
        color: white;
        border-radius: var(--btn-radius);
        padding: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: 1px solid var(--primary-dark);
        width: 100%;
        transition: var(--transition);
        font-size: 0.8rem;
        display: block;
        text-align: center;
        text-decoration: none;
    }

    .btn-premium:hover {
        background: transparent;
        color: var(--primary-dark);
    }

    .btn-outline-premium {
        background: transparent;
        color: var(--primary-dark);
        border: 1px solid #ddd;
        border-radius: var(--btn-radius);
        padding: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: var(--transition);
        text-align: center;
        text-decoration: none;
        display: block;
        font-size: 0.8rem;
    }

    .btn-outline-premium:hover {
        border-color: var(--primary-dark);
        background: var(--primary-dark);
        color: white;
    }
</style>

<div class="container py-5" style="margin-top: 90px;">
    <!-- Progress Indicator -->
    <div class="booking-progress-container">
        <div class="progress-step-bar">
            <div class="progress-line-fill" id="progressLine"></div>
            <div class="step-item active" id="stepIndicator1">
                1
                <span class="step-label-custom">Thông tin</span>
            </div>
            <div class="step-item" id="stepIndicator2">
                2
                <span class="step-label-custom">Thanh toán</span>
            </div>
            <div class="step-item" id="stepIndicator3">
                3
                <span class="step-label-custom">Hoàn tất</span>
            </div>
        </div>
    </div>

    <!-- MAIN FORM FOR MULTI-STEP SUBMISSION -->
    <form id="bookingWizardForm" method="POST" action="/Booking/Index">
        @Html.AntiForgeryToken()
        
        <!-- Hidden Inputs for Booking details -->
        <input type="hidden" id="hMaDichVu" name="MaDichVu" value="@ViewBag.SelectedServiceId" />
        <input type="hidden" id="hNgayChup" name="NgayChup" value="" />
        <input type="hidden" id="hKhungGio" name="KhungGio" value="" />
        
        <!-- Hidden Inputs for Payment details -->
        <input type="hidden" id="hHinhThucThanhToan" name="HinhThucThanhToan" value="DatCoc" />
        <input type="hidden" id="hPhuongThucThanhToan" name="PhuongThucThanhToan" value="Chuyển khoản QR" />
        <input type="hidden" id="hSoTienThanhToan" name="SoTienThanhToan" value="0" />
        <input type="hidden" id="hTongTienThucTe" name="TongTienThucTe" value="0" />

        <!-- ==================== STEP 1: FILL INFO ==================== -->
        <div id="step1Container">
            <div class="row mb-4">
                <div class="col-12 text-center">
                    <span class="section-label" style="letter-spacing: 5px;">Hama reservation</span>
                    <h1 class="serif display-5 fw-bold mt-1">Thông tin đặt lịch</h1>
                </div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger shadow-sm border-0 mb-4 rounded-3 text-center">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                </div>
            }

            <div class="row g-5">
                <div class="col-lg-7">
                    <!-- 1. Chọn Gói Dịch Vụ -->
                    <div class="mb-5">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="serif fw-bold mb-0">1. Chọn gói chụp</h5>
                            <span class="text-muted small">Vui lòng nhấp chọn 1 dịch vụ bên dưới</span>
                        </div>
                        <div class="search-wrapper">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" id="pkgSearch" class="search-input" placeholder="Tìm kiếm gói chụp nhanh..." oninput="filterPackages()">
                        </div>

                        <div id="packageList" class="d-flex flex-column gap-3">
                            @if (ViewBag.Services != null)
                            {
                                var services = ViewBag.Services as IEnumerable<HamaStudio.Models.DichVu>;
                                int? selectedId = ViewBag.SelectedServiceId as int?;
                                foreach (var svc in services)
                                {
                                    var addonsJson = Newtonsoft.Json.JsonConvert.SerializeObject((svc.DichVuBoSungs ?? new List<HamaStudio.Models.DichVuBoSung>()).Select(a => new { MaDVBS = a.MaDVBS, TenDVBS = a.TenDVBS, GiaTien = (double)a.GiaTien, MoTa = a.MoTa }));
                                    <div class="booking-pkg-card @(selectedId == svc.MaDichVu ? "selected" : "")" data-id="@svc.MaDichVu" data-price="@svc.GiaTien" data-addons='@Html.Raw(addonsJson)' onclick="selectPackage(this)">
                                        <img src="@(string.IsNullOrEmpty(svc.LinkAnhDaiDien) ? Url.Content("~/Content/Images/default.jpg") : (svc.LinkAnhDaiDien.StartsWith("http") ? svc.LinkAnhDaiDien : Url.Content("~/Content/Images/" + svc.LinkAnhDaiDien)))" onerror="this.src='https://images.unsplash.com/photo-1519225421980-715cb0215aed?w=300'" alt="@svc.TenDichVu" />
                                        <div class="pkg-content position-relative">
                                            <h6 class="serif fw-bold mb-1 pkg-name">@svc.TenDichVu</h6>
                                            <p class="text-muted small mb-2 pkg-description">@svc.MoTa</p>
                                            <div class="fw-bold text-dark">@svc.GiaTien.ToString("N0") ₫</div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <p id="noResults" class="text-muted mt-3 text-center" style="display:none;">Không tìm thấy gói phù hợp...</p>
                    </div>

                    <!-- 2. Dịch Vụ Bổ Sung -->
                    <div class="mb-5">
                        <h5 class="serif fw-bold mb-3">2. Dịch vụ đi kèm</h5>
                        <div id="addonsContainer" class="row g-3">
                            <p class="text-muted small">Vui lòng chọn gói chụp để hiển thị các dịch vụ đi kèm...</p>
                        </div>
                    </div>

                    <!-- 3. Địa điểm & Ghi chú -->
                    <div class="mb-4">
                        <h5 class="serif fw-bold mb-3">3. Chi tiết buổi chụp</h5>
                        <div class="mb-4 position-relative">
                            <!-- Đã ẩn các trường cũ để giữ nguyên DB -->
                            <div style="display: none;">
                                <label class="small text-uppercase fw-bold text-muted">Khu vực chụp hình *</label>
                                <select id="khuVucChup" class="input-luxury fw-bold text-dark mb-4">
                                    <option value="0" data-name="Nội thành Đà Nẵng" selected>Nội thành Đà Nẵng (Miễn phí)</option>
                                    <optgroup label="Ngoại thành / Tỉnh khác">
                                        <option value="500000" data-name="Quảng Nam">Quảng Nam (+ 500.000đ)</option>
                                        <option value="700000" data-name="Thừa Thiên Huế">Thừa Thiên Huế (+ 700.000đ)</option>
                                        <option value="1000000" data-name="Quảng Ngãi">Quảng Ngãi (+ 1.000.000đ)</option>
                                        <option value="1500000" data-name="Bình Định">Bình Định (+ 1.500.000đ)</option>
                                        <option value="2000000" data-name="Phú Yên">Phú Yên (+ 2.000.000đ)</option>
                                        <option value="2500000" data-name="Khánh Hòa">Khánh Hòa / Nha Trang (+ 2.500.000đ)</option>
                                        <option value="3000000" data-name="Lâm Đồng">Lâm Đồng / Đà Lạt (+ 3.000.000đ)</option>
                                        <option value="3500000" data-name="Bình Thuận">Ninh Thuận / Bình Thuận (+ 3.500.000đ)</option>
                                        <option value="4000000" data-name="TP. Hồ Chí Minh">TP. Hồ Chí Minh (+ 4.000.000đ)</option>
                                        <option value="4000000" data-name="Hà Nội">Hà Nội (+ 4.000.000đ)</option>
                                    </optgroup>
                                </select>
                                
                                <label class="small text-uppercase fw-bold text-muted">Địa chỉ chi tiết *</label>
                                <input type="text" id="diaDiem" class="input-luxury" placeholder="Số nhà, tên đường, tên quán cafe/resort...">
                            </div>
                            <input type="hidden" id="hDiaDiemGop" name="DiaDiem" value="" />

                            <!-- Các trường nhập mới -->
                            <!-- Các trường nhập mới -->
                            <label class="small text-uppercase fw-bold text-muted">Khu vực chụp hình *</label>
                            <div class="row g-2 mb-3">
                                <div class="col-md-4">
                                    <select id="tinhThanh" class="input-luxury fw-bold text-dark" style="font-size: 0.85rem;" onchange="loadDistricts()">
                                        <option value="">-- Tỉnh/Thành phố --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <select id="quanHuyen" class="input-luxury fw-bold text-dark" style="font-size: 0.85rem;" onchange="loadWards()" disabled>
                                        <option value="">-- Quận/Huyện --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <select id="phuongXa" class="input-luxury fw-bold text-dark" style="font-size: 0.85rem;" onchange="resetDistance()" disabled>
                                        <option value="">-- Phường/Xã --</option>
                                    </select>
                                </div>
                            </div>
                            
                            <label class="small text-uppercase fw-bold text-muted">Địa chỉ chi tiết *</label>
                            <div class="d-flex gap-2">
                                <input type="text" id="soNha" class="input-luxury flex-grow-1" placeholder="Số nhà, tên đường, tên quán cafe/resort..." oninput="resetDistance()" required>
                                <button type="button" class="btn btn-dark rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 45px; flex-shrink: 0;" id="btnConfirmAddress" onclick="calculateDistance()" title="Xác nhận và tính phí">
                                    <i class="bi bi-check-lg fs-5"></i>
                                </button>
                            </div>
                            <div id="distanceResult" class="small mt-2 p-2 rounded-2 bg-light border" style="display: none;"></div>
                            <div id="mapPicker" class="border" style="height: 300px; width: 100%; border-radius: 8px; margin-top: 10px; display: none; z-index: 1; position: relative;"></div>
                        </div>
                        <div class="mb-4">
                            <label class="small text-uppercase fw-bold text-muted">Số điện thoại liên hệ *</label>
                            <input type="tel" id="soDienThoai" name="SoDienThoai" class="input-luxury" placeholder="Ví dụ: 0336 486 377" required>
                        </div>
                        <div class="mb-4">
                            <label class="small text-uppercase fw-bold text-muted">Ghi chú yêu cầu đặc biệt</label>
                            <textarea id="ghiChu" name="GhiChu" class="input-luxury" rows="2" placeholder="Nhập ghi chú của bạn (Ví dụ: Concept cô dâu cổ điển, tone màu ấm, makeup nhẹ nhàng...)"></textarea>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="sidebar-box sticky-top" style="top:100px;">
                        <h5 class="serif fw-bold mb-4">4. Thời gian mong muốn</h5>
                        
                        <!-- Lịch chụp -->
                        <div class="mb-4">
                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <button type="button" class="btn btn-sm btn-light rounded-circle" id="prevMonth"><i class="bi bi-chevron-left"></i></button>
                                <span class="fw-bold small text-uppercase ls-1" id="calTitle"></span>
                                <button type="button" class="btn btn-sm btn-light rounded-circle" id="nextMonth"><i class="bi bi-chevron-right"></i></button>
                            </div>
                            <table class="w-100 mb-3 text-center">
                                <thead><tr class="small fw-bold text-muted"><th>T2</th><th>T3</th><th>T4</th><th>T5</th><th>T6</th><th>T7</th><th>CN</th></tr></thead>
                                <tbody id="calBody"></tbody>
                            </table>
                        </div>

                        <!-- Khung giờ -->
                        <label class="small text-uppercase fw-bold text-muted mb-3 d-block">Khung giờ buổi chụp</label>
                        <div class="row g-2 mb-2">
                            @foreach (var t in new[] { "08:00", "10:00", "14:00", "16:00", "19:00" })
                            {
                                <div class="col-4"><button type="button" class="time-slot" data-time="@t">@t</button></div>
                            }
                        </div>
                        <div id="slotNotice" class="small text-success mb-4 d-none"></div>

                        <!-- Tóm tắt -->
                        <div class="p-3 bg-light rounded-3">
                            <p class="small fw-bold text-uppercase ls-1 mb-3 border-bottom pb-2" style="color:var(--accent-gold);">Tóm tắt lịch đặt</p>
                            <div class="d-flex justify-content-between small mb-2"><span>Gói chụp:</span><span id="sumService" class="fw-bold text-end">—</span></div>
                            <div class="d-flex justify-content-between small mb-2"><span>Ngày chụp:</span><span id="sumDate" class="fw-bold">—</span></div>
                            <div class="d-flex justify-content-between small mb-2"><span>Khung giờ:</span><span id="sumTime" class="fw-bold">—</span></div>
                            <div class="d-flex justify-content-between small mb-2"><span>Địa điểm:</span><span id="sumLoc" class="fw-bold text-truncate ms-3" style="max-width:150px">—</span></div>
                            <div class="d-flex justify-content-between small mb-2"><span>Dịch vụ thêm:</span><span id="sumExtra" class="fw-bold">0 ₫</span></div>
                            <div class="d-flex justify-content-between small mb-2"><span>Phí di chuyển (<span id="sumDistance">0 km</span>):</span><span id="sumTravelFee" class="fw-bold text-success">Miễn phí</span></div>
