                        <button type="button" class="payment-method-btn" id="payMethodATM" onclick="selectPhuongThuc('Thẻ ATM nội địa')">
                            <i class="bi bi-credit-card-2-front fs-4 text-dark"></i>
                            <div>
                                <span class="d-block fw-bold small">Thẻ ATM nội địa / Internet Banking</span>
                                <span class="text-muted d-block" style="font-size:0.75rem;">Thanh toán an toàn qua cổng ngân hàng Việt Nam.</span>
