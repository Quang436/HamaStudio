@model IEnumerable<HamaStudio.Models.DatLich>

@{
    ViewBag.Title = "Lịch đã đặt | Hama Studio Experience";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-dark: #1a1a1a;
        --accent-gold: #c5a880;
        --bg-soft: #fdfdfd;
        --text-muted: #6c757d;
        --card-radius: 16px;
        --transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
        font-family: 'Montserrat', sans-serif;
        background-color: var(--bg-soft);
        color: var(--primary-dark);
    }

    .serif {
        font-family: 'Playfair Display', serif;
    }

    /* ===== HEADER ===== */
    .header-boxed {
        padding: 50px 0;
        background: linear-gradient(to bottom, #fcfcfc, var(--bg-soft));
        border-bottom: 1px solid #f0f0f0;
        margin-bottom: 40px;
        margin-top: 90px;
    }

    .section-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 4px;
        color: var(--accent-gold);
        font-weight: 700;
        display: block;
        margin-bottom: 8px;
    }

    /* ===== STATUS FILTER TABS ===== */
    .status-tab {
        background: white;
        border: 1px solid #e0e0e0;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 10px 24px;
        border-radius: 50px;
        transition: var(--transition);
        cursor: pointer;
    }

    .status-tab:hover {
        border-color: var(--accent-gold);
        color: var(--accent-gold);
        transform: translateY(-2px);
    }

    .status-tab.active {
        background: var(--primary-dark) !important;
        color: white !important;
        border-color: var(--primary-dark);
        box-shadow: 0 8px 15px rgba(0,0,0,0.08);
    }

    /* ===== STATUS BADGES ===== */
    .status-pill {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 6px 14px;
        border-radius: 50px;
        display: inline-block;
    }

    .status-pending {
        background: #f1f3f5;
        color: #495057;
    }

    .status-confirmed {
        background: #fdf6ec;
        color: #e6a23c;
    }

    .status-completed {
        background: #f0f9eb;
        color: #67c23a;
    }

    .status-cancelled {
        background: #fef0f0;
        color: #f56c6c;
    }

    /* ===== PAYMENT STATUS BADGES ===== */
    .pay-badge {
        font-size: 0.7rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
    }

    .bg-success-soft {
        background-color: rgba(103, 194, 58, 0.1);
        color: #67c23a;
    }

    .bg-warning-soft {
        background-color: rgba(230, 162, 60, 0.1);
        color: #e6a23c;
    }

    .bg-danger-soft {
        background-color: rgba(245, 108, 108, 0.1);
        color: #f56c6c;
    }

    /* ===== BOOKING CARDS ===== */
    .booking-card {
        background: white;
        border: 1px solid #eee;
        border-radius: var(--card-radius);
        overflow: hidden;
        transition: var(--transition);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .booking-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.06);
        border-color: var(--accent-gold);
    }

    .card-img-wrapper {
        position: relative;
        height: 220px;
        overflow: hidden;
        background: #f0f0f0;
    }

    .card-img-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: var(--transition);
    }

    .booking-card:hover .card-img-wrapper img {
        transform: scale(1.08);
    }

    .card-body-luxury {
        padding: 30px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .booking-title {
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        margin-bottom: 10px;
    }

    .detail-label {
        color: var(--text-muted);
    }

    .detail-value {
        font-weight: 600;
        color: var(--primary-dark);
        text-align: right;
    }

    .divider-gold {
        height: 1px;
        background: linear-gradient(to right, var(--accent-gold), transparent);
        margin: 20px 0;
        opacity: 0.25;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
    }

    /* ===== STAR RATING ===== */
    .stars-display {
        color: var(--accent-gold);
        font-size: 0.9rem;
    }

    /* ===== BUTTONS ===== */
    .btn-action {
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 6px 10px;
        border-radius: 5px;
        text-decoration: none;
        transition: var(--transition);
        display: inline-block;
        border: 1px solid transparent;
        cursor: pointer;
        white-space: nowrap;
    }

    .btn-action-cancel {
        border-color: #f56c6c;
        color: #f56c6c;
        background: transparent;
    }

    .btn-action-cancel:hover {
        background: #f56c6c;
        color: white;
    }

    .btn-action-pay {
        border-color: var(--accent-gold);
        color: var(--accent-gold);
        background: transparent;
    }

    .btn-action-pay:hover {
        background: var(--accent-gold);
        color: white;
    }

    .btn-action-review {
        border-color: var(--primary-dark);
        color: var(--primary-dark);
        background: transparent;
    }

    .btn-action-review:hover {
        background: var(--primary-dark);
        color: white;
    }

    .btn-action-disabled {
        border-color: #ddd;
        color: #999;
        background: #fafafa;
        cursor: not-allowed;
    }

    /* ===== CUSTOM CONFIRM MODAL ===== */
    .custom-confirm-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.4);
        display: flex; align-items: center; justify-content: center;
        z-index: 9999;
        opacity: 0; visibility: hidden;
        transition: all 0.3s ease;
        backdrop-filter: blur(4px);
    }
    .custom-confirm-overlay.active {
        opacity: 1; visibility: visible;
    }
    .custom-confirm-box {
        background: #fff; padding: 40px 30px; border-radius: 16px;
        text-align: center; max-width: 400px; width: 90%;
        transform: translateY(-20px) scale(0.95);
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
    }
    .custom-confirm-overlay.active .custom-confirm-box {
        transform: translateY(0) scale(1);
    }
</style>

<div class="header-boxed">
    <div class="container">
        <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
            <div class="text-center text-md-start">
                <span class="section-label">Member Dashboard</span>
                <h1 class="serif display-5 fw-bold mb-0">Quản lý lịch đặt của bạn</h1>
            </div>
            <div>
                <a href="/Booking" class="btn btn-dark rounded-pill px-4 py-3 fw-bold small text-uppercase ls-1" style="font-size:0.75rem;">
                    <i class="bi bi-plus-lg me-2"></i> ĐẶT BUỔI CHỤP MỚI
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- Status Filter Navigation Tabs -->
    <div class="d-flex justify-content-center gap-2 mb-5 flex-wrap" id="statusTabsContainer">
        <button class="status-tab active" data-status="all">Tất cả</button>
        <button class="status-tab" data-status="Chờ xác nhận">Chờ xác nhận</button>
        <button class="status-tab" data-status="Đã xác nhận">Đã xác nhận</button>
        <button class="status-tab" data-status="Hoàn thành">Hoàn thành</button>
        <button class="status-tab" data-status="Đã hủy">Đã hủy</button>
    </div>

    <!-- Booking Cards Container -->
    <div class="row g-4" id="bookingsRow">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                // Phân loại Class Trạng thái lịch chụp và cắt khoảng trắng thừa
                string trangThaiTrimmed = item.TrangThai != null ? item.TrangThai.Trim() : "";
                string statusClass = "status-pending";
                if (trangThaiTrimmed == "Đã xác nhận" || trangThaiTrimmed == "Đã đặt cọc") { statusClass = "status-confirmed"; }
                else if (trangThaiTrimmed == "Hoàn thành") { statusClass = "status-completed"; }
                else if (trangThaiTrimmed == "Đã hủy") { statusClass = "status-cancelled"; }

                // Tính toán tiền thanh toán
                decimal totalPaid = item.ThanhToans != null ? item.ThanhToans.Sum(t => t.SoTienThanhToan) : 0;
                decimal totalCost = item.TongTien ?? 0;
                decimal remainingBalance = totalCost - totalPaid;

                <div class="col-lg-4 col-md-6 booking-card-item" data-status="@trangThaiTrimmed">
                    <div class="booking-card">
                        <div class="card-img-wrapper">
                             <img src="@(string.IsNullOrEmpty(item.DichVu?.LinkAnhDaiDien) ? Url.Content("~/Content/Images/default.jpg") : (item.DichVu.LinkAnhDaiDien.StartsWith("http") ? item.DichVu.LinkAnhDaiDien : Url.Content("~/Content/Images/" + item.DichVu.LinkAnhDaiDien)))" onerror="this.src='https://images.unsplash.com/photo-1556228578-8c89e6adf883?w=600'" alt="@item.DichVu?.TenDichVu" />
                            <div class="position-absolute top-0 end-0 p-3">
                                <span class="status-pill @statusClass shadow-sm">@trangThaiTrimmed</span>
                                <!-- ✨ Badge auto-confirm nếu đơn được tự động xác nhận từ LichChup -->
                                @if (item.MaLichChup.HasValue && trangThaiTrimmed == "Đã xác nhận")
                                {
                                    <div class="mt-2">
                                        <span class="badge bg-success text-white d-flex align-items-center justify-content-center w-100" style="font-size:0.65rem; padding:4px 8px;">
                                            <i class="bi bi-star-fill me-1" style="font-size:0.5rem;"></i> Xác nhận tự động
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-body-luxury">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="serif booking-title mb-0">@(item.DichVu?.TenDichVu ?? "Dịch vụ")</h5>
                            </div>
                            
                            <!-- Mã đặt lịch và ngày chụp -->
                            <div class="detail-row">
                                <span class="detail-label">Mã số đơn:</span>
                                <span class="detail-value text-uppercase" style="color:var(--accent-gold);">LD@(item.MaDatLich.ToString("D4"))</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Ngày chụp hình:</span>
                                <span class="detail-value">@(item.NgayChup.ToString("dd/MM/yyyy"))</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Khung giờ chụp:</span>
                                <span class="detail-value">@item.KhungGio</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Địa điểm chụp:</span>
                                <span class="detail-value text-truncate ms-3" style="max-width:180px" title="@item.DiaDiem">@item.DiaDiem</span>
                            </div>

                            <div class="divider-gold"></div>

                            <!-- Trạng thái thanh toán -->
                            <div class="detail-row align-items-center mb-3">
                                <span class="detail-label">Trạng thái thanh toán:</span>
                                <span class="detail-value">
                                    @if (totalPaid >= totalCost && totalCost > 0)
                                    {
                                        <span class="pay-badge bg-success-soft"><i class="bi bi-check-circle-fill me-1"></i> Đủ 100%</span>
                                    }
                                    else if (totalPaid > 0)
                                    {
                                        <span class="pay-badge bg-warning-soft"><i class="bi bi-wallet2 me-1"></i> Đã cọc 30%</span>
                                    }
                                    else
                                    {
                                        <span class="pay-badge bg-danger-soft"><i class="bi bi-exclamation-circle me-1"></i> Chưa nộp tiền</span>
                                    }
                                </span>
                            </div>

                            <!-- Đánh giá hiển thị nếu có -->
                            @if (item.DanhGias != null && item.DanhGias.Any())
                            {
                                var review = item.DanhGias.First();
                                <div class="p-2 bg-light rounded mb-3 small text-muted border border-light">
                                    <div class="d-flex justify-content-between mb-1">
                                        <strong style="font-size:0.75rem;">Đánh giá của bạn:</strong>
                                        <span class="stars-display">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.SoSao)
                                                {
                                                    <i class="bi bi-star-fill text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star text-muted"></i>
                                                }
                                            }
                                        </span>
                                    </div>
                                    <p class="mb-0 text-truncate italic">"@review.NoiDungBinhLuan"</p>
                                </div>
                            }

                            <!-- Tổng chi phí & Nút hành động -->
                            <div class="total-row pt-2">
                                <div>
                                    <span class="text-muted small d-block">Tổng chi phí</span>
                                    <span class="fw-bold fs-5 text-dark">@totalCost.ToString("N0") ₫</span>
                                </div>
                                
                                <div class="action-buttons-wrapper d-flex gap-2">
                                    @if (trangThaiTrimmed == "Chờ xác nhận")
                                    {
                                        <button type="button" class="btn-action btn-action-cancel" onclick="triggerCancelBooking(@item.MaDatLich, '@item.NgayChup.ToString("yyyy-MM-dd")')">Hủy lịch</button>
                                    }
                                    else if (trangThaiTrimmed == "Đã xác nhận" || trangThaiTrimmed == "Đã đặt cọc")
                                    {
                                        if (remainingBalance > 0)
                                        {
                                            <a href="/Booking/PayRemaining/@item.MaDatLich" class="btn-action btn-action-pay" title="Thanh toán 70% còn lại">Thanh toán 70%</a>
                                        }
                                        <button type="button" class="btn-action btn-action-cancel" onclick="triggerCancelBooking(@item.MaDatLich, '@item.NgayChup.ToString("yyyy-MM-dd")')">Hủy lịch</button>
                                    }
                                    else if (trangThaiTrimmed == "Hoàn thành")
                                    {
                                        if (item.DanhGias != null && item.DanhGias.Any())
                                        {
                                            <button type="button" class="btn-action btn-action-disabled" disabled>Đã đánh giá</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn-action btn-action-review" onclick="openReviewModal(@item.MaDatLich, '@(item.DichVu?.TenDichVu ?? "Dịch vụ")')">Đánh giá</button>
                                        }
                                    }
                                </div>
                            </div>
                            
                            <!-- Đường dẫn Xem chi tiết gói chụp và các lựa chọn -->
                            <div class="text-center mt-3 pt-3 border-top" style="border-top-style: dashed !important; border-top-color: #eee !important;">
                                <a href="javascript:void(0)" class="text-decoration-none fw-bold small" style="color: var(--accent-gold); font-size: 0.72rem; letter-spacing: 0.5px;"
                                   data-id="LD@(item.MaDatLich.ToString("D4"))"
                                   data-booking-id="@item.MaDatLich"
                                   data-service="@(item.DichVu?.TenDichVu ?? "Dịch vụ")"
                                   data-service-desc="@(item.DichVu?.MoTa ?? "Chưa có mô tả chi tiết.")"
                                   data-img="@(string.IsNullOrEmpty(item.DichVu?.LinkAnhDaiDien) ? Url.Content("~/Content/Images/default.jpg") : (item.DichVu.LinkAnhDaiDien.StartsWith("http") ? item.DichVu.LinkAnhDaiDien : Url.Content("~/Content/Images/" + item.DichVu.LinkAnhDaiDien)))"
                                   data-date="@(item.NgayChup.ToString("dd/MM/yyyy"))"
                                   data-time="@item.KhungGio"
                                   data-location="@item.DiaDiem"
                                   data-notes="@(string.IsNullOrEmpty(item.GhiChu) ? "Không có ghi chú hoặc yêu cầu đặc biệt nào được ghi nhận." : item.GhiChu)"
                                   data-total="@(totalCost.ToString("N0")) ₫"
                                   data-paid="@(totalPaid.ToString("N0")) ₫"
                                   data-remaining="@(remainingBalance.ToString("N0")) ₫"
                                   data-status="@trangThaiTrimmed"
                                   data-link-anh="@item.LinkAnhBanGiao"
                                   onclick="openDetailsModal(this)">
                                    Xem chi tiết đơn hàng &amp; lựa chọn →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-calendar-x display-1 text-muted mb-3 d-block" style="opacity:0.25"></i>
                <h4 class="serif mb-2">Bạn chưa thực hiện cuộc đặt lịch nào</h4>
                <p class="text-muted mb-4">Hãy để chúng tôi đồng hành cùng những khoảnh khắc đẹp nhất của bạn!</p>
                <a href="/Booking" class="btn btn-dark rounded-pill px-5 py-3 fw-bold text-uppercase ls-1" style="font-size:0.8rem;">ĐẶT LỊCH NGAY</a>
            </div>
        }
    </div>

    <!-- No match filter result placeholder -->
    <div id="noMatchPlaceholder" class="text-center py-5" style="display:none;">
        <i class="bi bi-filter-circle display-2 text-muted mb-3 d-block" style="opacity:0.2"></i>
        <h5 class="serif text-muted">Không tìm thấy lịch đặt nào ở trạng thái này.</h5>
    </div>
</div>

<!-- ==================== HIDDEN CANCEL FORM ==================== -->
<form id="cancelBookingForm" method="POST" action="/Booking/CancelBooking" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="bookingId" id="cancelBookingId" />
</form>

<!-- ==================== BOOTSTRAP RATING MODAL ==================== -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true" style="backdrop-filter: blur(5px);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: var(--card-radius);">
            <div class="modal-header border-0 bg-light p-4" style="border-top-left-radius: var(--card-radius); border-top-right-radius: var(--card-radius);">
                <div>
                    <h5 class="modal-title serif fw-bold text-dark" id="reviewModalLabel">Đánh giá dịch vụ Hama</h5>
                    <span class="text-muted small d-block mt-1" id="reviewServiceName">Tên dịch vụ</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form action="/Booking/AddReview" method="POST">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" id="modalBookingId" />
                <input type="hidden" name="rating" id="modalRating" value="5" />

                <div class="modal-body p-4 text-center">
                    <p class="text-muted small mb-4">Trải nghiệm của bạn là động lực phát triển lớn nhất của Hama Studio. Vui lòng chia sẻ cảm nhận chân thực nhé!</p>

                    <!-- Interactive Star Rating -->
                    <div class="star-rating d-flex justify-content-center gap-3 mb-4" style="font-size: 2.2rem; cursor: pointer;">
                        <i class="bi bi-star-fill text-warning star-item" data-val="1"></i>
                        <i class="bi bi-star-fill text-warning star-item" data-val="2"></i>
                        <i class="bi bi-star-fill text-warning star-item" data-val="3"></i>
                        <i class="bi bi-star-fill text-warning star-item" data-val="4"></i>
                        <i class="bi bi-star-fill text-warning star-item" data-val="5"></i>
                    </div>

                    <div class="text-start mb-2">
                        <label class="small text-uppercase fw-bold text-muted mb-1">Nội dung bình luận của bạn *</label>
                        <textarea class="form-control" name="comment" rows="3" placeholder="Nhập cảm nhận về nước ảnh, thái độ phục vụ của nhiếp ảnh gia..." required style="border-radius:8px; font-size:0.9rem; padding:12px;"></textarea>
                    </div>
                </div>

                <div class="modal-footer border-0 p-4">
                    <button type="button" class="btn btn-light px-4 py-2" data-bs-dismiss="modal" style="border-radius:6px; font-size:0.8rem; font-weight:600;">HỦY BỎ</button>
                    <button type="submit" class="btn btn-dark px-4 py-2" style="border-radius:6px; font-size:0.8rem; font-weight:600; background:var(--primary-dark);">GỬI ĐÁNH GIÁ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ==================== BOOTSTRAP DETAILS MODAL ==================== -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true" style="backdrop-filter: blur(5px);">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow" style="border-radius: var(--card-radius); overflow: hidden;">
            <div class="modal-header border-0 bg-dark text-white p-4">
                <div>
                    <span class="text-uppercase small tracking-widest text-muted d-block mb-1" style="color: #c5a880 !important; font-size: 0.65rem; font-weight: 700; letter-spacing: 2px;">Booking Specification</span>
