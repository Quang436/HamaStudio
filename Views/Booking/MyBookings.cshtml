                    <!-- Right column: Customer Selections -->
                    <div class="col-md-7">
                        <div class="bg-white p-4 rounded-3 border border-light shadow-sm h-100">
                            <h6 class="serif fw-bold text-dark mb-3 border-bottom pb-2" style="border-color: #eee !important;"><i class="bi bi-person-badge me-2 text-muted"></i>Lựa chọn &amp; Thông tin của bạn</h6>
                            
                            <div class="d-flex flex-column gap-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">Mã đơn hàng:</span>
                                    <strong id="detailOrderId" class="text-uppercase small text-dark" style="color: var(--accent-gold) !important; letter-spacing: 1px;">LD0001</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">Ngày chụp hình:</span>
                                    <strong id="detailDate" class="small text-dark">06/06/2026</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">Khung giờ chụp:</span>
                                    <strong id="detailTime" class="small text-dark">08:00 - 17:00</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">Địa điểm chụp:</span>
                                    <strong id="detailLocation" class="small text-dark text-end" style="max-width: 220px;">Bà Nà Hills</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">Trạng thái đơn:</span>
                                    <span id="detailStatus" class="status-pill small py-1 px-3">Chờ xác nhận</span>
                                </div>
                                
                                <div class="border-top my-2" style="border-color:#eee !important;"></div>
                                
                                <div class="d-flex flex-column text-start">
                                    <span class="text-muted small mb-1"><i class="bi bi-pencil-square me-1"></i>Ghi chú &amp; Lựa chọn dịch vụ bổ sung:</span>
                                    <div class="p-3 bg-light rounded-3 text-muted small lh-lg font-monospace border border-light" id="detailNotes" style="font-size:0.8rem; white-space: pre-line; max-height:100px; overflow-y:auto;">
                                        Không có ghi chú.
                                    </div>
                                </div>
                                
                                <div class="border-top my-2" style="border-color:#eee !important;"></div>
                                
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">Đã thanh toán / đặt cọc:</span>
                                    <strong id="detailPaid" class="text-dark small">0 ₫</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">Còn lại cần nộp:</span>
                                    <strong id="detailRemaining" class="text-dark small">0 ₫</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <span class="fw-bold text-dark small">Tổng chi phí thực tế:</span>
                                    <strong id="detailTotal" class="fs-5 text-dark" style="color:var(--primary-dark) !important;">0 ₫</strong>
                                </div>

                                <!-- Dynamic Download / Photo Delivery Section -->
                                <div id="panelDownloadLink" class="d-none mt-3 p-3 rounded-3" style="border: 1px dashed #28a745; background-color: rgba(40, 167, 69, 0.03);">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="text-success fw-bold d-block small"><i class="bi bi-cloud-arrow-down-fill me-1"></i>Đã có bộ ảnh hoàn tất!</span>
                                            <span class="text-muted" style="font-size:0.7rem;">Ekip Hama đã hoàn thành xuất sắc album ảnh của bạn.</span>
                                        </div>
                                        <a id="btnDownloadPhotos" href="#" target="_blank" class="btn btn-success btn-sm rounded-pill px-3 fw-bold" style="font-size:0.75rem;"><i class="bi bi-download me-1"></i>Tải Album</a>
                                    </div>
                                </div>
                                <div id="panelDownloadProcessing" class="d-none mt-3 p-3 rounded-3" style="border: 1px dashed #e6a23c; background-color: rgba(230, 162, 60, 0.03);">
                                    <div class="d-flex align-items-center gap-2 text-warning small">
                                        <div class="spinner-border spinner-border-sm text-warning" role="status" style="width: 1rem; height: 1rem; border-width: 2px;"></div>
                                        <div>
                                            <strong class="d-block text-warning" style="font-size:0.75rem;">Đang xử lý hậu kỳ ảnh...</strong>
                                            <span class="text-muted" style="font-size:0.7rem;">Ekip đang chỉnh sửa bộ ảnh chụp của bạn. Vui lòng đợi nhé!</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Simulated Admin Control Box (For Testing & Demo) -->
                                <div class="mt-4 pt-3 border-top" style="border-top: 1px solid #eee !important;">
                                    <button class="btn btn-sm btn-outline-secondary w-100 text-uppercase fw-bold ls-1 p-2" type="button" data-bs-toggle="collapse" data-bs-target="#adminSimulateBox" aria-expanded="false" aria-controls="adminSimulateBox" style="font-size:0.65rem; border-radius:6px;">
                                        <i class="bi bi-gear-fill me-1"></i> Quản trị Hama Studio (Giả lập)
                                    </button>
                                    <div class="collapse mt-3" id="adminSimulateBox">
                                        <div class="p-3 bg-light rounded-3 text-start border border-light shadow-sm">
                                            <span class="badge bg-dark mb-2 text-uppercase fw-bold ls-1" style="font-size:0.6rem;">Studio Control Panel</span>
                                            <form action="/Booking/UpdateBookingAdmin" method="POST" id="adminUpdateForm">
                                                @Html.AntiForgeryToken()
                                                <!-- Hidden Input for Database MaDatLich -->
                                                <input type="hidden" name="bookingId" id="adminBookingId" />
                                                
                                                <div class="mb-2">
                                                    <label class="small fw-bold text-muted mb-1 d-block" style="font-size:0.7rem;">Cập nhật Trạng thái đơn:</label>
                                                    <select name="trangThai" id="adminSelectStatus" class="form-select form-select-sm" style="font-size:0.8rem; border-radius:6px; background-color: #fff;">
                                                        <option value="Chờ xác nhận">Chờ xác nhận</option>
                                                        <option value="Đã xác nhận">Đã xác nhận</option>
                                                        <option value="Đã đặt cọc">Đã đặt cọc</option>
                                                        <option value="Hoàn thành">Hoàn thành (Đã bàn giao sản phẩm)</option>
                                                        <option value="Đã hủy">Đã hủy lịch</option>
                                                    </select>
                                                </div>
                                                
                                                <div class="mb-3">
                                                    <label class="small fw-bold text-muted mb-1 d-block" style="font-size:0.7rem;">Link bàn giao ảnh (Chỉ dùng cho 'Hoàn thành'):</label>
                                                    <input type="text" name="linkAnh" id="adminLinkAnh" class="form-control form-control-sm" placeholder="Ví dụ: https://drive.google.com/..." style="font-size:0.8rem; border-radius:6px;" />
                                                </div>
                                                
                                                <button type="submit" class="btn btn-dark btn-sm w-100 fw-bold" style="font-size:0.75rem; border-radius:6px; background:var(--primary-dark); border-color: var(--primary-dark);">LƯU THAY ĐỔI</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="modal-footer border-0 bg-white p-4">
                <button type="button" class="btn btn-dark px-5 py-2 fw-semibold" data-bs-dismiss="modal" style="border-radius:6px; font-size:0.8rem; background: var(--primary-dark);">ĐÓNG LẠI</button>
            </div>
        </div>
    </div>
</div>

<!-- Custom Confirm Modal -->
<div id="customConfirmModal" class="custom-confirm-overlay">
    <div class="custom-confirm-box" style="max-width: 440px;">
        <i class="bi bi-exclamation-triangle-fill text-danger mb-3 d-block" style="font-size: 3.5rem;"></i>
        <h5 class="serif fw-bold text-dark">Xác nhận hủy lịch</h5>
        <p id="cancelWarningMsg" class="text-muted small mt-2 mb-4" style="line-height:1.6;"></p>
        <div class="d-flex justify-content-center gap-3">
            <button type="button" class="btn btn-light px-4 rounded-pill fw-semibold small" style="font-size: 0.75rem;" onclick="closeConfirmModal()">Giữ lại</button>
            <button type="button" class="btn btn-danger px-4 rounded-pill fw-semibold small" style="font-size: 0.75rem;" onclick="proceedCancelBooking()">Xác nhận hủy</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // ==================== 1. JS INTERACTIVE TABS FILTER ====================
        const tabs = document.querySelectorAll(".status-tab");
        const cards = document.querySelectorAll(".booking-card-item");
        const noMatchPlaceholder = document.getElementById("noMatchPlaceholder");

        tabs.forEach(tab => {
            tab.addEventListener("click", function () {
                // Đổi tab active
                tabs.forEach(t => t.classList.remove("active"));
                this.classList.add("active");

                const statusToFilter = this.dataset.status;
                let visibleCount = 0;

                cards.forEach(card => {
                    const cardStatus = card.dataset.status;
                    const isMatch = (statusToFilter === "all") || 
                                    (cardStatus === statusToFilter) || 
                                    (statusToFilter === "Đã xác nhận" && cardStatus === "Đã đặt cọc");
                    if (isMatch) {
                        card.style.display = "block";
                        visibleCount++;
                    } else {
                        card.style.display = "none";
                    }
                });

                // Hiển thị thông báo nếu không có lịch đặt nào
                if (visibleCount === 0 && cards.length > 0) {
                    noMatchPlaceholder.style.display = "block";
                } else {
                    noMatchPlaceholder.style.display = "none";
                }
            });
        });

        // ==================== 2. INTERACTIVE STAR SELECTION ====================
        const stars = document.querySelectorAll(".star-item");
        const modalRatingInput = document.getElementById("modalRating");

        stars.forEach(star => {
            star.addEventListener("click", function () {
                const val = parseInt(this.dataset.val);
                modalRatingInput.value = val;
                
                stars.forEach((s, idx) => {
                    if (idx < val) {
                        s.className = 'bi bi-star-fill text-warning star-item';
                    } else {
                        s.className = 'bi bi-star star-item';
                    }
                });
            });
        });
    });

    // ==================== 3. TRIGGER CANCEL BOOKING ====================
    let cancelBookingTargetId = null;

    function triggerCancelBooking(bookingId, photoshootDateStr) {
        cancelBookingTargetId = bookingId;
        
        // Tính khoảng cách ngày chụp và ngày hôm nay
        const today = new Date();
        today.setHours(0, 0, 0, 0); // Đặt về 0h để tính khoảng cách ngày chuẩn xác
        
        const photoDate = new Date(photoshootDateStr);
        photoDate.setHours(0, 0, 0, 0);
        
        const oneDayMs = 24 * 60 * 60 * 1000;
        const diffTime = photoDate - today;
        const diffDays = Math.ceil(diffTime / oneDayMs);
        
        const warningSpan = document.getElementById("cancelWarningMsg");
        
        if (diffDays <= 3) {
            warningSpan.innerHTML = `
                Bạn có chắc chắn muốn hủy yêu cầu đặt lịch này không?<br>
                <div class="alert alert-danger mt-3 small p-3 text-start mb-0" style="font-size: 0.75rem; border-radius: 8px; line-height: 1.5; border-color: rgba(245, 108, 108, 0.2); background-color: rgba(245, 108, 108, 0.05); color: #f56c6c;">
                    <i class="bi bi-exclamation-octagon-fill me-1"></i>
                    <strong>Chú ý:</strong> Chỉ còn <strong>${diffDays <= 0 ? 0 : diffDays} ngày</strong> là đến lịch chụp của bạn. Theo chính sách của Hama Studio, việc hủy lịch sát ngày chụp (3 ngày trở xuống) sẽ <strong>bị khấu trừ 30% tiền cọc</strong>!
                </div>
            `;
        } else {
            warningSpan.innerHTML = `
                Bạn có chắc chắn muốn hủy yêu cầu đặt lịch này không?<br>
                <span class="text-danger fw-semibold">Hành động này không thể hoàn tác.</span>
            `;
        }
        
        document.getElementById("customConfirmModal").classList.add("active");
    }

    function closeConfirmModal() {
        document.getElementById("customConfirmModal").classList.remove("active");
        cancelBookingTargetId = null;
    }

    function proceedCancelBooking() {
        if (cancelBookingTargetId) {
            document.getElementById("cancelBookingId").value = cancelBookingTargetId;
            document.getElementById("cancelBookingForm").submit();
        }
    }

    // ==================== 4. OPEN REVIEW MODAL ====================
    function openReviewModal(bookingId, serviceName) {
        document.getElementById("modalBookingId").value = bookingId;
        document.getElementById("reviewServiceName").textContent = serviceName;
        
        // Reset stars to 5 stars
        document.getElementById("modalRating").value = 5;
        const stars = document.querySelectorAll(".star-item");
        stars.forEach(s => s.className = 'bi bi-star-fill text-warning star-item');

        // Hiển thị modal qua Bootstrap API
        var myModal = new bootstrap.Modal(document.getElementById('reviewModal'));
        myModal.show();
    }

    // ==================== 5. OPEN DETAILS MODAL ====================
    function openDetailsModal(btn) {
        // Lấy dữ liệu từ data- attributes
        const orderId = btn.dataset.id;
        const bookingIdVal = btn.dataset.bookingId;
        const serviceName = btn.dataset.service;
        const serviceDesc = btn.dataset.serviceDesc;
        const imgUrl = btn.dataset.img;
        const date = btn.dataset.date;
        const time = btn.dataset.time;
        const location = btn.dataset.location;
        const notes = btn.dataset.notes;
        const total = btn.dataset.total;
        const paid = btn.dataset.paid;
        const remaining = btn.dataset.remaining;
        const status = btn.dataset.status;
        const linkAnh = btn.dataset.linkAnh || "";

        // Đổ dữ liệu vào Modal
        document.getElementById("detailOrderId").textContent = orderId;
        document.getElementById("detailServiceName").textContent = serviceName;
        document.getElementById("detailServiceDesc").textContent = serviceDesc;
        document.getElementById("detailImg").src = imgUrl;
        document.getElementById("detailDate").textContent = date;
        document.getElementById("detailTime").textContent = time;
        document.getElementById("detailLocation").textContent = location;
        document.getElementById("detailNotes").textContent = notes;
        document.getElementById("detailTotal").textContent = total;
        document.getElementById("detailPaid").textContent = paid;
        document.getElementById("detailRemaining").textContent = remaining;

        // Xử lý status pill class
        const statusPill = document.getElementById("detailStatus");
        statusPill.textContent = status;
        
        // Xóa class cũ
        statusPill.className = "status-pill small py-1 px-3";
        if (status === "Đã xác nhận" || status === "Đã đặt cọc" || status === "Đã đặt cọc 30%") {
            statusPill.classList.add("status-confirmed");
        } else if (status === "Hoàn thành") {
            statusPill.classList.add("status-completed");
        } else if (status === "Đã hủy") {
            statusPill.classList.add("status-cancelled");
        } else {
            statusPill.classList.add("status-pending");
        }

        // --- Xử lý Cổng Bàn Giao Ảnh (Feature 3) ---
        const panelDownloadLink = document.getElementById("panelDownloadLink");
        const panelDownloadProcessing = document.getElementById("panelDownloadProcessing");
        const btnDownloadPhotos = document.getElementById("btnDownloadPhotos");

        panelDownloadLink.classList.add("d-none");
        panelDownloadProcessing.classList.add("d-none");

        if (status === "Hoàn thành") {
            if (linkAnh && linkAnh.trim() !== "") {
                btnDownloadPhotos.href = linkAnh;
                panelDownloadLink.classList.remove("d-none");
            } else {
                panelDownloadProcessing.classList.remove("d-none");
            }
        }

        // --- Đổ dữ liệu vào Bảng điều khiển Quản trị Studio giả lập ---
        document.getElementById("adminBookingId").value = bookingIdVal;
        document.getElementById("adminSelectStatus").value = status;
        document.getElementById("adminLinkAnh").value = linkAnh;

        // Reset collapse panel admin box
        var adminCollapseEl = document.getElementById('adminSimulateBox');
        if (adminCollapseEl.classList.contains('show')) {
            var bsCollapse = bootstrap.Collapse.getInstance(adminCollapseEl);
            if (bsCollapse) bsCollapse.hide();
        }

        // Mở modal qua Bootstrap API
        var myModal = new bootstrap.Modal(document.getElementById('detailsModal'));
        myModal.show();
    }
</script>