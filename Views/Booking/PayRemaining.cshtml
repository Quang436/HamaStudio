@model HamaStudio.Models.DatLich
@{
    ViewBag.Title = "Thanh toán số dư còn lại | Hama Studio Experience";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var booking = ViewBag.Booking as HamaStudio.Models.DatLich;
    var remainingAmount = (decimal)ViewBag.RemainingAmount;
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-dark: #1a1a1a;
        --accent-gold: #c5a880;
        --bg-soft: #fdfdfd;
        --text-muted: #6c757d;
        --btn-radius: 8px;
        --card-radius: 16px;
        --transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
        font-family: 'Montserrat', sans-serif;
        background-color: var(--bg-soft);
        color: var(--primary-dark);
    }

    .serif {
        font-family: 'Playfair Display', serif;
    }

    .glass-card {
        background: white;
        border: 1px solid #eee;
        border-radius: var(--card-radius);
        box-shadow: 0 15px 35px rgba(0,0,0,0.03);
        padding: 40px;
    }

    .payment-method-btn {
        border: 1px solid #ddd;
        background: white;
        padding: 15px;
        border-radius: var(--btn-radius);
        display: flex;
        align-items: center;
        gap: 15px;
        cursor: pointer;
        transition: var(--transition);
        width: 100%;
        text-align: left;
    }

    .payment-method-btn:hover {
        border-color: var(--accent-gold);
        background: #fafaf8;
    }

    .payment-method-btn.active {
        border-color: var(--accent-gold);
        background: #fdfaf5;
        font-weight: 600;
    }

    .btn-premium {
        background: var(--primary-dark);
        color: white;
        border-radius: var(--btn-radius);
        padding: 16px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        border: 1px solid var(--primary-dark);
        width: 100%;
        transition: var(--transition);
        font-size: 0.85rem;
    }

    .btn-premium:hover {
        background: transparent;
        color: var(--primary-dark);
    }

    .btn-outline-premium {
        background: transparent;
        color: var(--primary-dark);
        border: 1px solid #ddd;
        border-radius: var(--btn-radius);
        padding: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: var(--transition);
        text-align: center;
        text-decoration: none;
        display: block;
        font-size: 0.8rem;
    }

    .btn-outline-premium:hover {
        border-color: var(--primary-dark);
        background: var(--primary-dark);
        color: white;
    }
</style>

<div class="container py-5" style="margin-top: 90px;">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="text-center mb-5">
                <span class="section-label" style="letter-spacing: 5px;">Hama Checkout</span>
                <h1 class="serif display-5 fw-bold mt-1">Thanh toán nốt số dư còn lại</h1>
                <p class="text-muted small">Mã lịch đặt: #HAMA-LD@(booking.MaDatLich.ToString("D4")) | Trạng thái: @booking.TrangThai</p>
            </div>

            <div class="glass-card">
                <div class="row g-5">
                    <div class="col-md-6 border-end">
                        <h5 class="serif fw-bold mb-4 pb-2 border-bottom">Thông tin lịch đặt</h5>
                        
                        <div class="mb-4">
                            <label class="small text-uppercase fw-bold text-muted d-block">Gói dịch vụ đã chọn</label>
                            <span class="fw-bold fs-5 text-dark">@booking.DichVu.TenDichVu</span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <label class="small text-uppercase fw-bold text-muted d-block">Ngày chụp hình</label>
                                <span class="fw-bold">@booking.NgayChup.Value.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="col-6">
                                <label class="small text-uppercase fw-bold text-muted d-block">Khung giờ chụp</label>
                                <span class="fw-bold">@booking.KhungGio</span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="small text-uppercase fw-bold text-muted d-block">Địa điểm chụp</label>
                            <span class="fw-bold text-muted">@booking.DiaDiem</span>
                        </div>

                        <div class="p-3 bg-light rounded-3">
                            <h6 class="serif fw-bold mb-3 border-bottom pb-2" style="font-size: 0.85rem;">Chi tiết dòng tiền</h6>
                            <div class="d-flex justify-content-between small mb-2"><span>Tổng tiền dịch vụ:</span><span>@booking.TongTien.Value.ToString("N0") ₫</span></div>
                            <div class="d-flex justify-content-between small mb-2 text-success"><span>Đã đặt cọc 30%:</span><span>- @booking.SoTienDaCoc.Value.ToString("N0") ₫</span></div>
                            <div style="height:1px; background:#ddd; margin:10px 0"></div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold">SỐ DƯ CẦN THANH TOÁN (70%):</span>
                                <span class="fw-bold text-dark fs-4">@remainingAmount.ToString("N0") ₫</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h5 class="serif fw-bold mb-4 pb-2 border-bottom">Thực hiện thanh toán</h5>

                        <form id="payRemainingForm" method="POST" action="/Booking/PayRemaining/@booking.MaDatLich">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="SoTienThanhToan" value="@remainingAmount" />
                            <input type="hidden" id="hPhuongThucThanhToan" name="PhuongThucThanhToan" value="Chuyển khoản QR" />

                            <div class="d-flex flex-column gap-3 mb-4">
                                <button type="button" class="payment-method-btn active" id="payMethodQR" onclick="selectPhuongThuc('Chuyển khoản QR')">
                                    <i class="bi bi-qr-code-scan fs-4 text-dark"></i>
                                    <div>
                                        <span class="d-block fw-bold small">Chuyển khoản bằng mã VietQR (Khuyên dùng)</span>
                                    </div>
                                </button>
                                <button type="button" class="payment-method-btn" id="payMethodATM" onclick="selectPhuongThuc('Thẻ ATM nội địa')">
                                    <i class="bi bi-credit-card-2-front fs-4 text-dark"></i>
                                    <div>
                                        <span class="d-block fw-bold small">Thẻ ATM nội địa / Internet Banking</span>
                                    </div>
                                </button>
                            </div>

                            <!-- QR Code Panel -->
                            <div id="panelQR" class="p-3 bg-light rounded-3 shadow-sm border border-warning text-center" style="background:#fffcf9 !important;">
                                <span class="badge bg-warning text-dark mb-3 text-uppercase fw-bold ls-1" style="font-size: 0.65rem;">Quét Mã QR VietQR</span>
                                
                                <div class="mx-auto bg-white p-3 rounded-3 shadow-sm border border-light mb-3" style="width:200px; height:200px;">
                                    @{
                                        string qrInfoText = "HAMA LD" + booking.MaDatLich.ToString("D4") + " NOT 70%";
                                        string qrUrl = $"https://img.vietqr.io/image/MB-0336486377-compact2.png?amount={Convert.ToInt64(remainingAmount)}&addInfo={Uri.EscapeDataString(qrInfoText)}&accountName=HAMA%20STUDIO";
                                    }
                                    <img id="imgQR" src="@qrUrl" alt="Mã QR thanh toán nốt" class="img-fluid w-100 h-100" />
                                </div>

                                <div class="text-start bg-white p-2 rounded border small mb-2">
                                    <strong>Nội dung ck:</strong> <span class="text-uppercase text-danger">@qrInfoText</span>
                                </div>
                                <p class="text-muted small mb-0" style="line-height: 1.5;">
                                    Quét mã QR trên để tự động nhập đầy đủ số tiền và thông tin giao dịch của lịch đặt này.
                                </p>
                            </div>

                            <!-- ATM Panel -->
                            <div id="panelATM" class="p-4 bg-light rounded-3 shadow-sm text-start" style="display:none;">
                                <span class="badge bg-dark text-white mb-3 text-uppercase fw-bold ls-1" style="font-size: 0.65rem;">Thẻ ATM nội địa</span>
                                <div class="mb-3">
                                    <label class="small fw-bold text-muted d-block mb-1">Số thẻ ngân hàng</label>
                                    <input type="text" class="form-control" placeholder="9704 0000 0000 0000" style="border-radius:6px; font-size:0.85rem;" />
                                </div>
                                <div class="mb-3">
                                    <label class="small fw-bold text-muted d-block mb-1">Tên chủ thẻ</label>
                                    <input type="text" class="form-control text-uppercase" placeholder="NGUYEN VAN A" style="border-radius:6px; font-size:0.85rem;" />
                                </div>
                            </div>

                            <div class="row g-2 mt-4">
                                <div class="col-4">
                                    <a href="/Booking/MyBookings" class="btn-outline-premium"><i class="bi bi-x-lg"></i> Hủy</a>
                                </div>
                                <div class="col-8">
                                    <button type="submit" class="btn-premium shadow-sm"><i class="bi bi-check-circle-fill me-2"></i> Đã chuyển khoản</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function selectPhuongThuc(method) {
        document.getElementById('payMethodQR').classList.remove('active');
        document.getElementById('payMethodATM').classList.remove('active');
        document.getElementById('hPhuongThucThanhToan').value = method;

        if (method === 'Chuyển khoản QR') {
            document.getElementById('payMethodQR').classList.add('active');
            document.getElementById('panelQR').style.display = 'block';
            document.getElementById('panelATM').style.display = 'none';
        } else {
            document.getElementById('payMethodATM').classList.add('active');
            document.getElementById('panelQR').style.display = 'none';
            document.getElementById('panelATM').style.display = 'block';
        }
    }
</script>
